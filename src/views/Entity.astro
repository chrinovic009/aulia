---
import Layout from '../layouts/Layout.astro';
import Status from '../components/Status.astro';
import Arrow from '../components/Arrow.astro';
import Icon from '../components/Icon.astro';
import Tiles from '../components/Tiles.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import { getContent } from '../data/site.ts';
import { path, contactPath, type Lang } from '../i18n.ts';

interface Props { lang: Lang; slug: string; }
const { lang, slug } = Astro.props;
const { entities } = getContent(lang);
const idx = entities.findIndex((x) => x.slug === slug);
const e = entities[idx];
const next = entities[(idx + 1) % entities.length];

const entityIcon: Record<string, string> = { care: 'medical', vigil: 'gauge', flow: 'flow', vr: 'vr' };
const capIcons: Record<string, string[]> = {
  care: ['monitor', 'file', 'link'],
  vigil: ['cpu', 'activity', 'trend', 'camera'],
  flow: ['box', 'cog', 'chart', 'trend'],
  vr: ['graduation', 'play', 'layers', 'users'],
};
const problemIcons = ['file', 'search', 'clock', 'alert'];
const archIcons = ['layers', 'lock', 'steps'];

const T = {
  en: {
    eco: 'Ecosystem', crumbs: 'Breadcrumb', mission: 'Mission',
    probEyebrow: 'The problem', probTitle: 'What we <em>solve.</em>',
    capEyebrow: 'Capabilities', capTitle: 'What we build, <em>and where we stand.</em>',
    archEyebrow: 'Principles', archTitle: 'How <em>it works.</em>',
    within: 'Within the ecosystem', animaTag: 'With ANIMA · target architecture',
    noDemo: 'No public demonstration yet.',
    ctaEyebrow: 'Contact', ctaTitle: (n: string) => `Talk to us <em>about ${n}.</em>`,
    ctaLabel: 'Request a presentation', next: 'Next:',
  },
  fr: {
    eco: 'Écosystème', crumbs: "Fil d'Ariane", mission: 'Mission',
    probEyebrow: 'Le problème', probTitle: 'Ce que nous <em>résolvons.</em>',
    capEyebrow: 'Capacités', capTitle: 'Ce que nous construisons, <em>et où nous en sommes.</em>',
    archEyebrow: 'Principes', archTitle: 'Comment <em>ça fonctionne.</em>',
    within: "Dans l'écosystème", animaTag: 'Avec ANIMA · architecture cible',
    noDemo: 'Pas encore de démonstration publique.',
    ctaEyebrow: 'Contact', ctaTitle: (n: string) => `Parlons <em>de ${n}.</em>`,
    ctaLabel: 'Demander une présentation', next: 'Suivant :',
  },
}[lang];

const problems = e.problems.map((p, i) => ({ icon: problemIcons[i % problemIcons.length], title: p }));
const caps = e.capabilities.map((c, i) => ({ icon: capIcons[e.slug][i] ?? 'spark', title: c.title, text: c.text, status: c.status }));
const arch = e.architecture.map((a, i) => ({ icon: archIcons[i] ?? 'spark', title: a.title }));
---

<Layout lang={lang} route="ecosystem" sub={e.slug} title={e.name} description={e.summary}>
  <section class="hero">
    <div class="blobs" aria-hidden="true"></div>
    <span class="giant" aria-hidden="true">{e.short}</span>
    <div class="wrap hero-grid">
      <div>
        <nav class="crumbs" aria-label={T.crumbs}>
          <a href={path(lang, 'ecosystem')}>{T.eco}</a><span>/</span><span aria-current="page">{e.name}</span>
        </nav>
        <p class="eyebrow">{e.sector}</p>
        <h1 class="display display-l">{e.name}</h1>
        <p class="tagline">{e.tagline}</p>
        <div class="meta"><Status status={e.status} lang={lang} /></div>
        {e.demo && (
          <a class="btn btn-ghost demo" href={e.demo.href} target="_blank" rel="noopener">{e.demo.label}<Arrow /></a>
        )}
      </div>
      <div class="emblem" aria-hidden="true">
        <span class="ring r1"></span><span class="ring r2"></span>
        <span class="big-ico"><Icon name={entityIcon[e.slug]} size={72} /></span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="mission reveal">
        <span class="m-ico"><Icon name="target" size={28} /></span>
        <div>
          <p class="eyebrow">{T.mission}</p>
          <p class="m-text">{e.mission}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={T.probEyebrow} title={T.probTitle} center />
      <Tiles items={problems} cols={problems.length} lang={lang} compact />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={T.capEyebrow} title={T.capTitle} center />
      <Tiles items={caps} cols={caps.length} lang={lang} />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={T.archEyebrow} title={T.archTitle} center />
      <Tiles items={arch} cols={arch.length} lang={lang} center />
    </div>
  </section>

  <section class="section">
    <div class="wrap eco reveal">
      <div class="eco-card">
        <span class="m-ico"><Icon name="layers" size={24} /></span>
        <h3>{T.within}</h3>
        <p>{e.ecosystem}</p>
      </div>
      <div class="eco-card dashed">
        <span class="m-ico"><Icon name="network" size={24} /></span>
        <h3>{T.animaTag}</h3>
        <p>{e.animaLink}</p>
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow={T.ctaEyebrow}
    title={T.ctaTitle(e.name)}
    href={contactPath(lang, e.slug)}
    label={T.ctaLabel}
    secondary={{ href: path(lang, 'ecosystem', next.slug), label: `${T.next} ${next.name}` }}
  />
</Layout>

<style>
  .hero {
    position: relative;
    padding-top: clamp(8rem, 15vw, 10rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .giant {
    position: absolute;
    left: -0.03em;
    bottom: -0.2em;
    font-size: clamp(8rem, 24vw, 22rem);
    font-weight: 800;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 210, 48, 0.08);
    user-select: none;
  }
  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 2rem;
    align-items: center;
  }
  .crumbs {
    display: flex;
    gap: 0.6rem;
    font-size: 0.85rem;
    color: var(--faint);
    margin-bottom: 1.75rem;
  }
  .crumbs a {
    color: var(--muted);
  }
  .crumbs a:hover {
    color: var(--gold-bright);
  }
  h1 {
    margin-top: 1rem;
  }
  .tagline {
    margin-top: 1rem;
    font-size: clamp(1.15rem, 1.8vw, 1.4rem);
    color: #d1d5dc;
    max-width: 32rem;
  }
  .meta {
    margin-top: 1.5rem;
  }
  .demo {
    margin-top: 1.75rem;
  }
  .emblem {
    position: relative;
    justify-self: center;
    width: min(100%, 300px);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
  }
  .ring {
    position: absolute;
    border-radius: 50%;
    border: 1px dashed rgba(255, 210, 48, 0.35);
    animation: spin 40s linear infinite;
  }
  .r1 {
    inset: 0;
  }
  .r2 {
    inset: 14%;
    border-style: solid;
    border-color: rgba(255, 255, 255, 0.08);
    animation-direction: reverse;
  }
  .big-ico {
    width: 52%;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: var(--gold-bright);
    background: radial-gradient(circle at 50% 30%, rgba(150, 114, 29, 0.5), rgba(30, 41, 57, 0.9) 70%);
    border: 1px solid rgba(255, 210, 48, 0.35);
    box-shadow: 0 0 80px rgba(150, 114, 29, 0.35);
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .mission {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    padding: clamp(1.75rem, 4vw, 3rem);
    border-radius: 1.75rem;
    border: 1px solid rgba(255, 210, 48, 0.25);
    background: radial-gradient(ellipse at 0% 0%, rgba(150, 114, 29, 0.25), transparent 60%), var(--card);
  }
  .m-ico {
    flex: none;
    width: 3.25rem;
    height: 3.25rem;
    display: grid;
    place-items: center;
    border-radius: 1rem;
    background: rgba(150, 114, 29, 0.3);
    color: var(--gold-bright);
  }
  .m-text {
    margin-top: 1rem;
    font-size: clamp(1.25rem, 2.2vw, 1.8rem);
    font-weight: 600;
    line-height: 1.35;
  }
  .eco {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  .eco-card {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding: 1.75rem;
    border-radius: 1.5rem;
    border: 1px solid var(--line-strong);
    background: var(--card);
  }
  .eco-card.dashed {
    border-style: dashed;
    border-color: var(--gold-dim);
    background: transparent;
  }
  .eco-card h3 {
    font-size: 1.1rem;
  }
  .eco-card p {
    color: var(--muted);
    font-size: 0.95rem;
  }
  @media (max-width: 860px) {
    .hero-grid,
    .eco {
      grid-template-columns: 1fr;
    }
    .emblem {
      width: 200px;
      order: -1;
    }
    .mission {
      flex-direction: column;
    }
  }
</style>
