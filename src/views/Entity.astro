---
import Layout from '../layouts/Layout.astro';
import Status from '../components/Status.astro';
import Arrow from '../components/Arrow.astro';
import CtaBand from '../components/CtaBand.astro';
import { getContent } from '../data/site.ts';
import { path, contactPath, type Lang } from '../i18n.ts';

interface Props { lang: Lang; slug: string; }
const { lang, slug } = Astro.props;
const { entities } = getContent(lang);
const idx = entities.findIndex((x) => x.slug === slug);
const e = entities[idx];
const next = entities[(idx + 1) % entities.length];

const T = {
  en: {
    eco: 'Ecosystem', crumbs: 'Breadcrumb', member: 'A company of the AULIA group',
    s1: '01 — Overview', mission: 'Mission',
    s2: '02 — Problems addressed', s2t: 'Starting <em>from the field.</em>',
    s3: '03 — Solutions & capabilities', s3t: 'What we are building, <em>and where we stand.</em>', s3l: 'Each capability shows its actual level of maturity.',
    s4: '04 — Architecture & principles', s4t: 'How <em>we see it.</em>',
    s5: '05 — Demonstration', noDemo: 'No public demonstration is available at this time.',
    s6: '06 — Within the ecosystem', animaTag: 'ANIMA · target architecture',
    ctaEyebrow: 'Sales contact', ctaTitle: (n: string) => `Talk about your project <em>with ${n}.</em>`,
    ctaText: 'Tell us about your context and your needs: we will answer with what is actually available and what is in preparation.',
    ctaLabel: 'Request a presentation', next: 'Next:',
  },
  fr: {
    eco: 'Écosystème', crumbs: "Fil d'Ariane", member: 'Entreprise du groupe AULIA',
    s1: '01 — Présentation', mission: 'Mission',
    s2: '02 — Problèmes adressés', s2t: 'Partir <em>du terrain.</em>',
    s3: '03 — Solutions & capacités', s3t: 'Ce que nous construisons, <em>et où nous en sommes.</em>', s3l: 'Chaque capacité est accompagnée de son niveau de maturité réel.',
    s4: '04 — Architecture & principes', s4t: "Comment <em>nous l'envisageons.</em>",
    s5: '05 — Démonstration', noDemo: "Aucune démonstration publique n'est disponible pour le moment.",
    s6: "06 — Dans l'écosystème", animaTag: 'ANIMA · architecture cible',
    ctaEyebrow: 'Contact commercial', ctaTitle: (n: string) => `Parler de votre projet <em>avec ${n}.</em>`,
    ctaText: 'Présentez-nous votre contexte et vos besoins : nous vous répondrons avec ce qui est réellement disponible et ce qui est en préparation.',
    ctaLabel: 'Demander une présentation', next: 'Suivant :',
  },
}[lang];
---

<Layout lang={lang} route="ecosystem" sub={e.slug} title={e.name} description={e.summary}>
  <section class="hero">
    <div class="hero-bg" aria-hidden="true">
      <span class="giant">{e.short}</span>
    </div>
    <div class="wrap">
      <nav class="crumbs" aria-label={T.crumbs}>
        <a href={path(lang, 'ecosystem')}>{T.eco}</a><span>/</span><span aria-current="page">{e.name}</span>
      </nav>
      <p class="eyebrow">{e.sector}</p>
      <h1 class="display display-l">{e.name}</h1>
      <p class="tagline">{e.tagline}</p>
      <div class="meta"><Status status={e.status} lang={lang} /><span>{T.member}</span></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap two">
      <div class="reveal">
        <p class="eyebrow">{T.s1}</p>
        <div class="prose big">
          {e.presentation.map((p) => <p>{p}</p>)}
        </div>
      </div>
      <div class="reveal mission">
        <p class="eyebrow">{T.mission}</p>
        <p class="mission-text">{e.mission}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap two">
      <div class="reveal">
        <p class="eyebrow">{T.s2}</p>
        <h2 class="display display-m" set:html={T.s2t} />
      </div>
      <ol class="problems reveal">
        {e.problems.map((p, i) => (
          <li><span class="index">{String(i + 1).padStart(2, '0')}</span><p>{p}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head reveal">
        <p class="eyebrow">{T.s3}</p>
        <h2 class="display display-m" set:html={T.s3t} />
        <p class="lead">{T.s3l}</p>
      </div>
      <ul class="caps reveal">
        {e.capabilities.map((c) => (
          <li>
            <Status status={c.status} lang={lang} />
            <h3>{c.title}</h3>
            <p>{c.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap two">
      <div class="reveal">
        <p class="eyebrow">{T.s4}</p>
        <h2 class="display display-m" set:html={T.s4t} />
      </div>
      <dl class="arch reveal">
        {e.architecture.map((a) => (
          <div><dt>{a.title}</dt><dd>{a.text}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="wrap two">
      <div class="reveal">
        <p class="eyebrow">{T.s5}</p>
        {e.demo ? (
          <div class="demo">
            <p class="muted">{e.demo.note}</p>
            <a class="btn btn-ghost" href={e.demo.href} target="_blank" rel="noopener">{e.demo.label}<Arrow /></a>
          </div>
        ) : (
          <p class="muted demo">{T.noDemo}</p>
        )}
      </div>
      <div class="reveal eco">
        <p class="eyebrow">{T.s6}</p>
        <p class="prose">{e.ecosystem}</p>
        <div class="anima-note">
          <span class="tag">{T.animaTag}</span>
          <p>{e.animaLink}</p>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow={T.ctaEyebrow}
    title={T.ctaTitle(e.name)}
    text={T.ctaText}
    href={contactPath(lang, e.slug)}
    label={T.ctaLabel}
    secondary={{ href: path(lang, 'ecosystem', next.slug), label: `${T.next} ${next.name}` }}
  />
</Layout>

<style>
  .hero {
    position: relative;
    padding-top: clamp(9rem, 18vw, 12rem);
    padding-bottom: clamp(4rem, 8vw, 6rem);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 50% 70% at 90% 30%, rgba(198, 164, 92, 0.1), transparent 70%);
  }
  .giant {
    position: absolute;
    right: -0.04em;
    bottom: -0.18em;
    font-family: var(--font-display);
    font-size: clamp(8rem, 26vw, 24rem);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgba(198, 164, 92, 0.16);
    letter-spacing: -0.02em;
    user-select: none;
  }
  .wrap {
    position: relative;
  }
  .crumbs {
    display: flex;
    gap: 0.6rem;
    font-size: 0.8rem;
    color: var(--faint);
    margin-bottom: 2.5rem;
  }
  .crumbs a {
    color: var(--muted);
  }
  .crumbs a:hover {
    color: var(--gold);
  }
  h1 {
    margin-top: 1.25rem;
  }
  .tagline {
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-style: normal;
    font-size: clamp(1.3rem, 2.2vw, 1.8rem);
    color: #c9c8c3;
    max-width: 36rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    align-items: center;
    margin-top: 2rem;
    font-size: 0.8rem;
    color: var(--faint);
  }
  .two {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
  }
  .two h2 {
    margin-top: 1.5rem;
  }
  .big {
    margin-top: 1.75rem;
    font-size: 1.08rem;
  }
  .mission {
    border-left: 1px solid var(--gold);
    padding-left: 2rem;
    align-self: start;
  }
  .mission-text {
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.2vw, 1.85rem);
    line-height: 1.35;
  }
  .head {
    display: grid;
    gap: 1.5rem;
    max-width: 52rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .problems {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .problems li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--line);
    color: #c9c8c3;
  }
  .problems .index {
    padding-top: 0.3rem;
  }
  .caps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1px;
    background: var(--line-strong);
    border: 1px solid var(--line-strong);
    border-radius: 1.5rem;
    overflow: hidden;
  }
  .caps li {
    background: var(--card);
    padding: 2rem 1.75rem 2.25rem;
    display: grid;
    gap: 0.9rem;
    align-content: start;
  }
  .caps h3 {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: 1.6rem;
    line-height: 1.15;
  }
  .caps p {
    color: var(--muted);
    font-size: 0.93rem;
  }
  .arch {
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .arch div {
    padding: 1.6rem 0;
    border-bottom: 1px solid var(--line);
    display: grid;
    gap: 0.5rem;
  }
  .arch dt {
    font-family: var(--font-display);
    font-size: 1.4rem;
  }
  .arch dd {
    margin: 0;
    color: var(--muted);
  }
  .demo {
    margin-top: 1.5rem;
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  .eco {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }
  .anima-note {
    border: 1px dashed var(--gold-dim);
    padding: 1.5rem;
    display: grid;
    gap: 0.6rem;
  }
  .anima-note p {
    color: #bdbcb7;
    font-size: 0.93rem;
  }
  .tag {
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
  }
  @media (max-width: 900px) {
    .two {
      grid-template-columns: 1fr;
    }
  }
</style>
