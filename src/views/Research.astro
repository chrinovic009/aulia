---
import page from '../data/pages/research.ts';
import { block } from '../data/site.ts';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Tiles from '../components/Tiles.astro';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { getContent } from '../data/site.ts';
import { path, contactPath, type Lang } from '../i18n.ts';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const { research } = getContent(lang, Astro.locals);
const researchIcons = ['cpu', 'atom', 'cog', 'factory', 'server', 'box', 'link', 'user'];

const T = block(Astro.locals, 'page:research', lang, page);
const axes = research.map((r, i) => ({ icon: researchIcons[i], title: r.title }));
---

<Layout lang={lang} route="research" title={T.title} description={T.meta}>
  <PageHero eyebrow={T.title} title={T.hero} lead={T.lead} />

  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={T.fEyebrow} title={T.fTitle} center />
      <ul class="chips reveal">
        {T.foundations.map((f) => <li><Icon name="spark" size={16} />{f}</li>)}
      </ul>
      <p class="honest reveal">{T.honest}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={T.aEyebrow} title={T.aTitle} center />
      <Tiles items={axes} cols={4} lang={lang} center compact />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={T.mEyebrow} title={T.mTitle} center />
      <Tiles items={T.method} cols={4} lang={lang} center />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="empty reveal">
        <Icon name="book" size={28} />
        <div><p class="eyebrow">{T.pEyebrow}</p><p>{T.empty}</p></div>
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow={T.ctaEyebrow}
    title={T.ctaTitle}
    href={contactPath(lang, 'research')}
    label={T.ctaLabel}
    secondary={{ href: path(lang, 'anima'), label: T.ctaSecondary }}
  />
</Layout>

<style>
  .chips {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    max-width: 56rem;
  }
  .chips li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.2rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: var(--card);
    font-weight: 600;
  }
  .chips :global(svg) {
    color: var(--gold-bright);
  }
  .honest {
    margin-top: 2rem;
    text-align: center;
    font-size: 0.9rem;
    color: var(--faint);
  }
  .empty {
    display: flex;
    gap: 1.25rem;
    align-items: center;
    max-width: 44rem;
    margin: 0 auto;
    padding: 1.75rem;
    border-radius: 1.5rem;
    border: 1px dashed var(--line-strong);
    color: var(--muted);
  }
  .empty > :global(svg) {
    flex: none;
    color: var(--gold-bright);
  }
  .empty p:last-child {
    margin-top: 0.5rem;
  }
</style>
