---
import page from '../data/pages/ecosystem.ts';
import { block } from '../data/site.ts';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import EcosystemMap from '../components/EcosystemMap.astro';
import Status from '../components/Status.astro';
import Arrow from '../components/Arrow.astro';
import Icon from '../components/Icon.astro';
import Tiles from '../components/Tiles.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import { getContent } from '../data/site.ts';
import { path, type Lang } from '../i18n.ts';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const { entities } = getContent(lang, Astro.locals);
const entityIcon: Record<string, string> = { care: 'medical', vigil: 'gauge', flow: 'flow', vr: 'vr' };

const T = block(Astro.locals, 'page:ecosystem', lang, page);
---

<Layout lang={lang} route="ecosystem" title={T.title} description={T.meta}>
  <PageHero eyebrow={T.title} title={T.hero} lead={T.lead} />

  <section class="section">
    <div class="wrap">
      <Tiles items={T.roles} cols={3} lang={lang} center />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={T.mapEyebrow} title={T.mapTitle} center />
      <div class="reveal"><EcosystemMap interactive lang={lang} /></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={T.compEyebrow} title={T.compTitle} center />
      <div class="uni">
        {entities.map((e, i) => (
          <a href={path(lang, 'ecosystem', e.slug)} class="uni-card reveal" style={`transition-delay:${i * 80}ms`}>
            <div class="uni-top" aria-hidden="true">
              <span class="uni-ico"><Icon name={entityIcon[e.slug] ?? 'layers'} size={40} /></span>
              <span class="uni-short">{e.short}</span>
            </div>
            <div class="uni-body">
              <Status status={e.status} lang={lang} />
              <h3>{e.name}</h3>
              <p>{e.tagline}</p>
              <span class="go"><Arrow /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBand eyebrow="ANIMA" title={T.ctaTitle} href={path(lang, 'anima')} label={T.ctaLabel} />
</Layout>

<style>
  .uni {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }
  .uni-card {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    border-radius: 1.5rem;
    border: 1px solid var(--line-strong);
    background: var(--card);
    transition:
      transform 0.4s var(--ease),
      border-color 0.4s var(--ease);
  }
  .uni-card:hover {
    transform: translateY(-6px);
    border-color: rgba(255, 210, 48, 0.45);
  }
  .uni-top {
    position: relative;
    height: 9.5rem;
    display: grid;
    place-items: center;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 130%, rgba(150, 114, 29, 0.55), transparent 62%),
      linear-gradient(180deg, var(--card-hover), var(--card));
  }
  .uni-ico {
    position: relative;
    z-index: 1;
    width: 5rem;
    height: 5rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: var(--gold-bright);
    background: rgba(var(--bg-rgb), 0.55);
    border: 1px solid rgba(255, 210, 48, 0.3);
    transition: transform 0.5s var(--ease);
  }
  .uni-card:hover .uni-ico {
    transform: scale(1.08) rotate(-4deg);
  }
  .uni-short {
    position: absolute;
    inset: auto 0 -1.7rem 0;
    text-align: center;
    font-size: 4.5rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 210, 48, 0.14);
  }
  .uni-body {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: 1.4rem 1.4rem 1.6rem;
  }
  .uni-body h3 {
    font-size: 1.35rem;
  }
  .uni-body p {
    font-size: 0.9rem;
    color: var(--muted);
    padding-right: 2rem;
  }
  .go {
    position: absolute;
    right: 1.25rem;
    bottom: 1.4rem;
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--primary);
    color: #fff;
  }
  .go :global(svg) {
    width: 0.95rem;
  }
  @media (max-width: 1080px) {
    .uni {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 520px) {
    .uni {
      grid-template-columns: 1fr;
    }
  }
</style>
