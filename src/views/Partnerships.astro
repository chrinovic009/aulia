---
import page from '../data/pages/partnerships.ts';
import { block } from '../data/site.ts';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Tiles from '../components/Tiles.astro';
import Timeline from '../components/Timeline.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import { contactPath, type Lang } from '../i18n.ts';

interface Props { lang: Lang; }
const { lang } = Astro.props;

const T = block(Astro.locals, 'page:partnerships', lang, page);
const kinds = T.kinds.map((k) => ({ icon: k.icon, title: k.title, text: k.text, href: contactPath(lang, k.topic) }));
---

<Layout lang={lang} route="partnerships" title={T.title} description={T.meta}>
  <PageHero eyebrow={T.title} title={T.hero} lead={T.lead} />

  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={T.kEyebrow} title={T.kTitle} center />
      <Tiles items={kinds} cols={3} lang={lang} />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={T.sEyebrow} title={T.sTitle} center />
      <Timeline items={T.steps} />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={T.cEyebrow} title={T.cTitle} center />
      <Tiles items={T.commit} cols={4} lang={lang} center />
    </div>
  </section>

  <CtaBand eyebrow={T.ctaEyebrow} title={T.ctaTitle} href={contactPath(lang, 'partnership')} label={T.ctaLabel} />
</Layout>
