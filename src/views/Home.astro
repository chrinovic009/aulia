---
import Layout from '../layouts/Layout.astro';
import HeroEmblem from '../components/HeroEmblem.astro';
import EcosystemMap from '../components/EcosystemMap.astro';
import AnimaCore from '../components/AnimaCore.astro';
import Status from '../components/Status.astro';
import Arrow from '../components/Arrow.astro';
import Icon from '../components/Icon.astro';
import Tiles from '../components/Tiles.astro';
import Timeline from '../components/Timeline.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import { getContent } from '../data/site.ts';
import { path, contactPath, type Lang } from '../i18n.ts';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const { entities, anima, research, doctrine } = getContent(lang);

const entityIcon: Record<string, string> = { care: 'medical', vigil: 'gauge', flow: 'flow', vr: 'vr' };
const doctrineIcons = ['search', 'radar', 'bulb', 'shield', 'transform'];
const mottoIcons = ['wave', 'message', 'trend', 'network', 'bolt'];
const researchIcons = ['cpu', 'atom', 'cog', 'factory', 'server', 'box', 'link', 'user'];

const T = {
  en: {
    h1: 'Building Intelligence. <span class="gold">Transforming Systems.</span>',
    tagline: 'A technology group building specialised companies for essential systems.',
    explore: 'Explore the ecosystem',
    discover: 'Discover ANIMA',
    pillars: [
      ['building', 'A parent company'],
      ['layers', 'Specialised companies'],
      ['network', 'A transversal intelligence'],
    ],
    docEyebrow: 'Doctrine',
    docTitle: 'Five verbs. <em>One direction.</em>',
    ecoEyebrow: 'Ecosystem',
    ecoTitle: 'One vision. <em>Multiple intelligences.</em>',
    seeMap: 'See the full ecosystem',
    animaEyebrow: 'ANIMA',
    animaTitle: 'The intelligence <em>behind the systems.</em>',
    animaLead: 'One architecture to perceive, understand and coordinate — under human control.',
    pathEyebrow: 'Our path',
    pathTitle: 'Prove first. <em>Then grow.</em>',
    path: [
      { icon: 'medical', title: 'AULIA Care', text: 'First proof in the field' },
      { icon: 'factory', title: 'Vigil & Flow', text: 'Industrial value' },
      { icon: 'network', title: 'ANIMA', text: 'Transversal intelligence' },
      { icon: 'expand', title: 'New companies', text: 'As needs emerge' },
    ],
    resEyebrow: 'Research & Innovation',
    resTitle: 'Mastering technology, <em>not just using it.</em>',
    resLink: 'Explore our research',
    ctaEyebrow: 'Partnerships',
    ctaTitle: "Let's build <em>what matters.</em>",
    ctaLabel: 'Build with AULIA',
    ctaSecondary: 'Request a presentation',
  },
  fr: {
    h1: "Construire l'intelligence. <span class=\"gold\">Transformer les systèmes.</span>",
    tagline: 'Un groupe technologique qui bâtit des entreprises spécialisées pour les systèmes essentiels.',
    explore: "Explorer l'écosystème",
    discover: 'Découvrir ANIMA',
    pillars: [
      ['building', 'Une société mère'],
      ['layers', 'Des entreprises spécialisées'],
      ['network', 'Une intelligence transversale'],
    ],
    docEyebrow: 'Doctrine',
    docTitle: 'Cinq verbes. <em>Une direction.</em>',
    ecoEyebrow: 'Écosystème',
    ecoTitle: 'Une vision. <em>Plusieurs intelligences.</em>',
    seeMap: "Voir tout l'écosystème",
    animaEyebrow: 'ANIMA',
    animaTitle: "L'intelligence <em>derrière les systèmes.</em>",
    animaLead: 'Une architecture pour percevoir, comprendre et coordonner — sous contrôle humain.',
    pathEyebrow: 'Notre trajectoire',
    pathTitle: "Prouver d'abord. <em>Grandir ensuite.</em>",
    path: [
      { icon: 'medical', title: 'AULIA Care', text: 'Première preuve sur le terrain' },
      { icon: 'factory', title: 'Vigil & Flow', text: 'Valeur industrielle' },
      { icon: 'network', title: 'ANIMA', text: 'Intelligence transversale' },
      { icon: 'expand', title: 'Nouvelles entreprises', text: 'Selon les besoins' },
    ],
    resEyebrow: 'Recherche & Innovation',
    resTitle: "Maîtriser la technologie, <em>pas seulement l'utiliser.</em>",
    resLink: 'Explorer notre recherche',
    ctaEyebrow: 'Partenariats',
    ctaTitle: 'Construisons <em>ce qui compte.</em>',
    ctaLabel: 'Construire avec AULIA',
    ctaSecondary: 'Demander une présentation',
  },
}[lang];

const doctrineTiles = doctrine.map((d, i) => ({ icon: doctrineIcons[i], title: d.word, text: d.short }));
const researchTiles = research.map((r, i) => ({ icon: researchIcons[i], title: r.title }));
---

<Layout lang={lang} route="home">
  <!-- HERO -->
  <section class="hero" id="home">
    <div class="blobs" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <div class="hero-visual"><HeroEmblem lang={lang} /></div>
      <h1 class="display display-xl" set:html={T.h1} />
      <p class="lead">{T.tagline}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={path(lang, 'ecosystem')}>{T.explore}<Arrow /></a>
        <a class="btn btn-ghost" href={path(lang, 'anima')}>{T.discover}</a>
      </div>
      <ul class="pillars">
        {T.pillars.map(([icon, label]) => (
          <li><span class="p-ico"><Icon name={icon} size={20} /></span>{label}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- DOCTRINE -->
  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={T.docEyebrow} title={T.docTitle} center />
      <Tiles items={doctrineTiles} cols={5} lang={lang} center />
    </div>
  </section>

  <!-- ÉCOSYSTÈME -->
  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={T.ecoEyebrow} title={T.ecoTitle} center />
      <div class="uni">
        {entities.map((e, i) => (
          <a href={path(lang, 'ecosystem', e.slug)} class="uni-card reveal" style={`transition-delay:${i * 80}ms`}>
            <div class="uni-top" aria-hidden="true">
              <span class="uni-ico"><Icon name={entityIcon[e.slug]} size={40} /></span>
              <span class="uni-short">{e.short}</span>
            </div>
            <div class="uni-body">
              <Status status={e.status} lang={lang} />
              <h3>{e.name}</h3>
              <p>{e.sector}</p>
              <span class="go"><Arrow /></span>
            </div>
          </a>
        ))}
      </div>
      <div class="map-row">
        <div class="reveal"><EcosystemMap lang={lang} /></div>
      </div>
      <p class="center-link reveal"><a class="link-arrow" href={path(lang, 'ecosystem')}>{T.seeMap}<Arrow /></a></p>
    </div>
  </section>

  <!-- ANIMA -->
  <section class="section anima">
    <div class="wrap">
      <SectionHead eyebrow={T.animaEyebrow} title={T.animaTitle} lead={T.animaLead} center />
      <div class="anima-visual reveal"><AnimaCore lang={lang} /></div>
      <ol class="motto reveal">
        {anima.motto.map((m, i) => (
          <li><span class="m-ico"><Icon name={mottoIcons[i]} size={22} /></span><span>{m}</span></li>
        ))}
      </ol>
      <div class="center-link reveal">
        <a class="btn btn-primary" href={path(lang, 'anima')}>{T.discover}<Arrow /></a>
        <span class="anima-state"><Status status={anima.status} lang={lang} /></span>
      </div>
    </div>
  </section>

  <!-- TRAJECTOIRE -->
  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={T.pathEyebrow} title={T.pathTitle} center />
      <Timeline items={T.path} />
    </div>
  </section>

  <!-- RECHERCHE -->
  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={T.resEyebrow} title={T.resTitle} center />
      <Tiles items={researchTiles} cols={4} lang={lang} compact />
      <p class="center-link reveal"><a class="link-arrow" href={path(lang, 'research')}>{T.resLink}<Arrow /></a></p>
    </div>
  </section>

  <CtaBand
    eyebrow={T.ctaEyebrow}
    title={T.ctaTitle}
    href={path(lang, 'partnerships')}
    label={T.ctaLabel}
    secondary={{ href: contactPath(lang, 'presentation'), label: T.ctaSecondary }}
  />
</Layout>

<style>
  .hero {
    position: relative;
    padding-top: 6rem;
    padding-bottom: 3.5rem;
    overflow: hidden;
  }
  .hero-inner {
    position: relative;
    display: grid;
    justify-items: center;
    text-align: center;
  }
  .hero-visual {
    width: min(100%, 250px);
    margin-bottom: 1.25rem;
  }
  .hero h1 {
    max-width: 15em;
  }
  .hero .lead {
    margin: 1.5rem auto 0;
    max-width: 38rem;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem 1.5rem;
    margin-top: 2.5rem;
  }
  .pillars {
    list-style: none;
    margin: 3.5rem 0 0;
    padding: 1.5rem 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem 3rem;
    border-block: 1px solid #1e2939;
    width: 100%;
    max-width: 56rem;
  }
  .pillars li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 600;
    color: #e5e7eb;
  }
  .p-ico {
    width: 2.25rem;
    height: 2.25rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgba(150, 114, 29, 0.25);
    color: var(--gold-bright);
  }

  /* Écosystème */
  .uni {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }
  .uni-card {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    border-radius: 1.5rem;
    border: 1px solid var(--line-strong);
    background: var(--card);
    transition:
      transform 0.4s var(--ease),
      border-color 0.4s var(--ease);
  }
  .uni-card:hover {
    transform: translateY(-6px);
    border-color: rgba(255, 210, 48, 0.45);
  }
  .uni-top {
    position: relative;
    height: 9.5rem;
    display: grid;
    place-items: center;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 130%, rgba(150, 114, 29, 0.55), transparent 62%),
      linear-gradient(180deg, #243246, #1e2939);
  }
  .uni-ico {
    position: relative;
    z-index: 1;
    width: 5rem;
    height: 5rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: var(--gold-bright);
    background: rgba(17, 16, 13, 0.55);
    border: 1px solid rgba(255, 210, 48, 0.3);
    transition: transform 0.5s var(--ease);
  }
  .uni-card:hover .uni-ico {
    transform: scale(1.08) rotate(-4deg);
  }
  .uni-short {
    position: absolute;
    inset: auto 0 -1.7rem 0;
    text-align: center;
    font-size: 4.5rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 210, 48, 0.14);
  }
  .uni-body {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: 1.4rem 1.4rem 1.6rem;
  }
  .uni-body h3 {
    font-size: 1.35rem;
  }
  .uni-body p {
    font-size: 0.9rem;
    color: var(--muted);
    padding-right: 2rem;
  }
  .go {
    position: absolute;
    right: 1.25rem;
    bottom: 1.4rem;
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--primary);
    color: #fff;
    transition: transform 0.4s var(--ease);
  }
  .go :global(svg) {
    width: 0.95rem;
  }
  .uni-card:hover .go {
    transform: translateX(4px);
  }
  .map-row {
    max-width: 560px;
    margin: clamp(3rem, 6vw, 4.5rem) auto 0;
  }
  .center-link {
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  /* ANIMA */
  .anima {
    background: radial-gradient(ellipse 55% 60% at 50% 45%, rgba(150, 114, 29, 0.14), transparent 70%);
  }
  .anima-visual {
    max-width: 760px;
    margin: 0 auto;
  }
  .motto {
    list-style: none;
    margin: 2.5rem auto 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }
  .motto li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 1.1rem 0.55rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: var(--card);
    font-weight: 700;
  }
  .m-ico {
    width: 2.25rem;
    height: 2.25rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgba(150, 114, 29, 0.3);
    color: var(--gold-bright);
  }

  @media (max-width: 1080px) {
    .uni {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .hero-visual {
      width: 220px;
    }
    .pillars {
      flex-direction: column;
      align-items: flex-start;
      max-width: 20rem;
      gap: 0.9rem;
    }
  }
  @media (max-width: 520px) {
    .uni {
      grid-template-columns: 1fr;
    }
    .uni-top {
      height: 8rem;
    }
  }
</style>
