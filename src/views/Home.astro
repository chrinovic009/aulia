---
import '../styles/global.css'; // d'abord le style commun, pour que celui de la page passe après (comme avant)
import './styles/home.css';
import page from '../data/pages/home.ts';
import { block } from '../data/site.ts';
import Layout from '../layouts/Layout.astro';
import HeroEmblem from '../components/HeroEmblem.astro';
import EcosystemMap from '../components/EcosystemMap.astro';
import AnimaCore from '../components/AnimaCore.astro';
import Status from '../components/Status.astro';
import Arrow from '../components/Arrow.astro';
import Icon from '../components/Icon.astro';
import Tiles from '../components/Tiles.astro';
import Timeline from '../components/Timeline.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import { getContent } from '../data/site.ts';
import { path, contactPath, type Lang } from '../i18n.ts';
import partnersPage from '../data/pages/partnerships.ts';
import PartnerMarquee from '../components/PartnerMarquee.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const { entities, anima, research, doctrine } = getContent(lang, Astro.locals);

const entityIcon: Record<string, string> = { care: 'medical', vigil: 'gauge', flow: 'flow', vr: 'vr' };
const doctrineIcons = ['search', 'radar', 'bulb', 'shield', 'transform'];
const mottoIcons = ['wave', 'message', 'trend', 'network', 'bolt'];
const researchIcons = ['cpu', 'atom', 'cog', 'factory', 'server', 'box', 'link', 'user'];

const T = block(Astro.locals, 'page:home', lang, page);

const P = block(Astro.locals, 'page:partnerships', lang, partnersPage);
const roadmap = entities.filter((e) => e.slug !== 'care');
const doctrineTiles = doctrine.map((d, i) => ({ icon: doctrineIcons[i], title: d.word, text: d.short }));
const researchTiles = research.map((r, i) => ({ icon: researchIcons[i], title: r.title }));
---

<Layout lang={lang} route="home">
<div class="v-home">
  <!-- HERO -->
  <section class="hero" id="home">
    <div class="blobs" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <div class="hero-visual"><HeroEmblem lang={lang} /></div>
      <h1 class="display display-xl" set:html={T.h1} />
      <p class="lead">{T.tagline}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={path(lang, 'ecosystem')}>{T.explore}<Arrow /></a>
        <a class="btn btn-ghost" href={path(lang, 'anima')}>{T.discover}</a>
      </div>
      <ul class="pillars">
        {T.pillars.map(([icon, label]) => (
          <li><span class="p-ico"><Icon name={icon} size={20} /></span>{label}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- PREUVES : AULIA CARE + PARTENAIRES -->
  <section class="section care-first">
    <div class="wrap care-grid">
      <div class="care-text reveal">
        <p class="eyebrow">{T.careEyebrow}</p>
        <h2 class="display display-l" set:html={T.careTitle} />
        <p class="lead">{T.careText}</p>
        <div class="care-actions">
          <a class="btn btn-primary" href="https://demo-aulia-care.vercel.app" target="_blank" rel="noopener" data-track="Démo AULIA Care (accueil)">{T.careDemo}<Arrow /></a>
          <a class="btn btn-ghost" href={contactPath(lang, 'care')}>{T.carePilot}</a>
        </div>
      </div>
      <a class="care-card reveal" href={path(lang, 'ecosystem', 'care')}>
        <span class="care-badge"><i aria-hidden="true"></i>{T.careStatus}</span>
        <span class="care-ico" aria-hidden="true"><Icon name="medical" size={44} /></span>
        <b>AULIA Care</b>
        <ul>
          {T.careList.map((c, i) => <li class:list={[{ on: i === 0 }]}>{c}</li>)}
        </ul>
        <span class="go"><Arrow /></span>
      </a>
    </div>
    {P.partners?.length > 0 && (
      <div class="proof">
        <p class="proof-label">{T.partnersLabel}</p>
        <PartnerMarquee partners={P.partners} label={T.partnersLabel} />
      </div>
    )}
  </section>

  <!-- FONDATEUR -->
  <section class="section founder-band">
    <div class="wrap founder-row reveal">
      <img class="f-photo" src="/images/team/tumba-nyembo-chrinovic-carre.webp" alt={T.founderName} width="480" height="480" loading="lazy" />
      <div>
        <p class="eyebrow">{T.founderEyebrow}</p>
        <blockquote>« {T.founderQuote} »</blockquote>
        <p class="f-who"><b>{T.founderName}</b> · {T.founderRole}</p>
        <a class="link-arrow" href={path(lang, 'about')}>{T.founderLink}<Arrow /></a>
      </div>
    </div>
  </section>

  <!-- DOCTRINE -->
  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={T.docEyebrow} title={T.docTitle} center />
      <Tiles items={doctrineTiles} cols={5} lang={lang} center />
    </div>
  </section>

  <!-- ÉCOSYSTÈME -->
  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={T.roadEyebrow} title={T.roadTitle} center />
      <div class="uni uni-3">
        {roadmap.map((e, i) => (
          <a href={path(lang, 'ecosystem', e.slug)} class="uni-card reveal" style={`transition-delay:${i * 80}ms`}>
            <div class="uni-top" aria-hidden="true">
              <span class="uni-ico"><Icon name={entityIcon[e.slug] ?? 'layers'} size={40} /></span>
              <span class="uni-short">{e.short}</span>
            </div>
            <div class="uni-body">
              <Status status={e.status} lang={lang} />
              <h3>{e.name}</h3>
              <p>{e.sector}</p>
              <span class="go"><Arrow /></span>
            </div>
          </a>
        ))}
      </div>
      <div class="map-row">
        <div class="reveal"><EcosystemMap lang={lang} /></div>
      </div>
      <p class="center-link reveal"><a class="link-arrow" href={path(lang, 'ecosystem')}>{T.seeMap}<Arrow /></a></p>
    </div>
  </section>

  <!-- ANIMA -->
  <section class="section anima">
    <div class="wrap">
      <SectionHead eyebrow={T.animaEyebrow} title={T.animaTitle} lead={T.animaLead} center />
      <div class="anima-visual reveal"><AnimaCore lang={lang} /></div>
      <ol class="motto reveal">
        {anima.motto.map((m, i) => (
          <li><span class="m-ico"><Icon name={mottoIcons[i]} size={22} /></span><span>{m}</span></li>
        ))}
      </ol>
      <div class="center-link reveal">
        <a class="btn btn-primary" href={path(lang, 'anima')}>{T.discover}<Arrow /></a>
        <span class="anima-state"><Status status={anima.status} lang={lang} /></span>
      </div>
    </div>
  </section>

  <!-- TRAJECTOIRE -->
  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={T.pathEyebrow} title={T.pathTitle} center />
      <Timeline items={T.path} />
    </div>
  </section>

  <!-- RECHERCHE -->
  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={T.resEyebrow} title={T.resTitle} center />
      <Tiles items={researchTiles} cols={4} lang={lang} compact />
      <p class="center-link reveal"><a class="link-arrow" href={path(lang, 'research')}>{T.resLink}<Arrow /></a></p>
    </div>
  </section>

  <CtaBand
    eyebrow={T.ctaEyebrow}
    title={T.ctaTitle}
    href={path(lang, 'partnerships')}
    label={T.ctaLabel}
    secondary={{ href: contactPath(lang, 'presentation'), label: T.ctaSecondary }}
  />
</div>
</Layout>

