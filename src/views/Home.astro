---
import page from '../data/pages/home.ts';
import { block } from '../data/site.ts';
import Layout from '../layouts/Layout.astro';
import HeroEmblem from '../components/HeroEmblem.astro';
import EcosystemMap from '../components/EcosystemMap.astro';
import AnimaCore from '../components/AnimaCore.astro';
import Status from '../components/Status.astro';
import Arrow from '../components/Arrow.astro';
import Icon from '../components/Icon.astro';
import Tiles from '../components/Tiles.astro';
import Timeline from '../components/Timeline.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import { getContent } from '../data/site.ts';
import { path, contactPath, type Lang } from '../i18n.ts';
import partnersPage from '../data/pages/partnerships.ts';
import PartnerMarquee from '../components/PartnerMarquee.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const { entities, anima, research, doctrine } = getContent(lang, Astro.locals);

const entityIcon: Record<string, string> = { care: 'medical', vigil: 'gauge', flow: 'flow', vr: 'vr' };
const doctrineIcons = ['search', 'radar', 'bulb', 'shield', 'transform'];
const mottoIcons = ['wave', 'message', 'trend', 'network', 'bolt'];
const researchIcons = ['cpu', 'atom', 'cog', 'factory', 'server', 'box', 'link', 'user'];

const T = block(Astro.locals, 'page:home', lang, page);

const P = block(Astro.locals, 'page:partnerships', lang, partnersPage);
const roadmap = entities.filter((e) => e.slug !== 'care');
const doctrineTiles = doctrine.map((d, i) => ({ icon: doctrineIcons[i], title: d.word, text: d.short }));
const researchTiles = research.map((r, i) => ({ icon: researchIcons[i], title: r.title }));
---

<Layout lang={lang} route="home">
  <!-- HERO -->
  <section class="hero" id="home">
    <div class="blobs" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <div class="hero-visual"><HeroEmblem lang={lang} /></div>
      <h1 class="display display-xl" set:html={T.h1} />
      <p class="lead">{T.tagline}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={path(lang, 'ecosystem')}>{T.explore}<Arrow /></a>
        <a class="btn btn-ghost" href={path(lang, 'anima')}>{T.discover}</a>
      </div>
      <ul class="pillars">
        {T.pillars.map(([icon, label]) => (
          <li><span class="p-ico"><Icon name={icon} size={20} /></span>{label}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- PREUVES : AULIA CARE + PARTENAIRES -->
  <section class="section care-first">
    <div class="wrap care-grid">
      <div class="care-text reveal">
        <p class="eyebrow">{T.careEyebrow}</p>
        <h2 class="display display-l" set:html={T.careTitle} />
        <p class="lead">{T.careText}</p>
        <div class="care-actions">
          <a class="btn btn-primary" href="https://demo-aulia-care.vercel.app" target="_blank" rel="noopener" data-track="Démo AULIA Care (accueil)">{T.careDemo}<Arrow /></a>
          <a class="btn btn-ghost" href={contactPath(lang, 'care')}>{T.carePilot}</a>
        </div>
      </div>
      <a class="care-card reveal" href={path(lang, 'ecosystem', 'care')}>
        <span class="care-badge"><i aria-hidden="true"></i>{T.careStatus}</span>
        <span class="care-ico" aria-hidden="true"><Icon name="medical" size={44} /></span>
        <b>AULIA Care</b>
        <ul>
          {T.careList.map((c, i) => <li class:list={[{ on: i === 0 }]}>{c}</li>)}
        </ul>
        <span class="go"><Arrow /></span>
      </a>
    </div>
    {P.partners?.length > 0 && (
      <div class="proof">
        <p class="proof-label">{T.partnersLabel}</p>
        <PartnerMarquee partners={P.partners} label={T.partnersLabel} />
      </div>
    )}
  </section>

  <!-- FONDATEUR -->
  <section class="section founder-band">
    <div class="wrap founder-row reveal">
      <img class="f-photo" src="/images/team/tumba-nyembo-chrinovic-carre.webp" alt={T.founderName} width="480" height="480" loading="lazy" />
      <div>
        <p class="eyebrow">{T.founderEyebrow}</p>
        <blockquote>« {T.founderQuote} »</blockquote>
        <p class="f-who"><b>{T.founderName}</b> · {T.founderRole}</p>
        <a class="link-arrow" href={path(lang, 'about')}>{T.founderLink}<Arrow /></a>
      </div>
    </div>
  </section>

  <!-- DOCTRINE -->
  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={T.docEyebrow} title={T.docTitle} center />
      <Tiles items={doctrineTiles} cols={5} lang={lang} center />
    </div>
  </section>

  <!-- ÉCOSYSTÈME -->
  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={T.roadEyebrow} title={T.roadTitle} center />
      <div class="uni uni-3">
        {roadmap.map((e, i) => (
          <a href={path(lang, 'ecosystem', e.slug)} class="uni-card reveal" style={`transition-delay:${i * 80}ms`}>
            <div class="uni-top" aria-hidden="true">
              <span class="uni-ico"><Icon name={entityIcon[e.slug] ?? 'layers'} size={40} /></span>
              <span class="uni-short">{e.short}</span>
            </div>
            <div class="uni-body">
              <Status status={e.status} lang={lang} />
              <h3>{e.name}</h3>
              <p>{e.sector}</p>
              <span class="go"><Arrow /></span>
            </div>
          </a>
        ))}
      </div>
      <div class="map-row">
        <div class="reveal"><EcosystemMap lang={lang} /></div>
      </div>
      <p class="center-link reveal"><a class="link-arrow" href={path(lang, 'ecosystem')}>{T.seeMap}<Arrow /></a></p>
    </div>
  </section>

  <!-- ANIMA -->
  <section class="section anima">
    <div class="wrap">
      <SectionHead eyebrow={T.animaEyebrow} title={T.animaTitle} lead={T.animaLead} center />
      <div class="anima-visual reveal"><AnimaCore lang={lang} /></div>
      <ol class="motto reveal">
        {anima.motto.map((m, i) => (
          <li><span class="m-ico"><Icon name={mottoIcons[i]} size={22} /></span><span>{m}</span></li>
        ))}
      </ol>
      <div class="center-link reveal">
        <a class="btn btn-primary" href={path(lang, 'anima')}>{T.discover}<Arrow /></a>
        <span class="anima-state"><Status status={anima.status} lang={lang} /></span>
      </div>
    </div>
  </section>

  <!-- TRAJECTOIRE -->
  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={T.pathEyebrow} title={T.pathTitle} center />
      <Timeline items={T.path} />
    </div>
  </section>

  <!-- RECHERCHE -->
  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={T.resEyebrow} title={T.resTitle} center />
      <Tiles items={researchTiles} cols={4} lang={lang} compact />
      <p class="center-link reveal"><a class="link-arrow" href={path(lang, 'research')}>{T.resLink}<Arrow /></a></p>
    </div>
  </section>

  <CtaBand
    eyebrow={T.ctaEyebrow}
    title={T.ctaTitle}
    href={path(lang, 'partnerships')}
    label={T.ctaLabel}
    secondary={{ href: contactPath(lang, 'presentation'), label: T.ctaSecondary }}
  />
</Layout>

<style>
  .hero {
    position: relative;
    padding-top: 6rem;
    padding-bottom: 3.5rem;
    overflow: hidden;
  }
  .hero-inner {
    position: relative;
    display: grid;
    justify-items: center;
    text-align: center;
  }
  .hero-visual {
    width: min(100%, 250px);
    margin-bottom: 1.25rem;
  }
  .hero h1 {
    max-width: 15em;
  }
  .hero .lead {
    margin: 1.5rem auto 0;
    max-width: 38rem;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem 1.5rem;
    margin-top: 2.5rem;
  }
  .pillars {
    list-style: none;
    margin: 3.5rem 0 0;
    padding: 1.5rem 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem 3rem;
    border-block: 1px solid var(--card);
    width: 100%;
    max-width: 56rem;
  }
  .pillars li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 600;
    color: var(--text-soft);
  }
  .p-ico {
    width: 2.25rem;
    height: 2.25rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgba(150, 114, 29, 0.25);
    color: var(--gold-bright);
  }

  /* Écosystème */
  .uni {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }
  .uni.uni-3 {
    grid-template-columns: repeat(3, 1fr);
  }

  /* AULIA Care en premier */
  .care-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  .care-text .display {
    margin-top: 1rem;
  }
  .care-text .lead {
    margin-top: 1.25rem;
  }
  .care-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .care-card {
    position: relative;
    display: grid;
    gap: 1rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: 1.5rem;
    border: 1px solid var(--line-strong);
    background:
      radial-gradient(ellipse at 100% 0%, rgba(150, 114, 29, 0.22), transparent 60%),
      var(--card);
    transition:
      transform 0.4s var(--ease),
      border-color 0.4s var(--ease);
  }
  .care-card:hover {
    transform: translateY(-4px);
    border-color: var(--gold);
  }
  .care-badge {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #2f7d4a;
    background: rgba(156, 199, 154, 0.16);
    border: 1px solid rgba(156, 199, 154, 0.45);
  }
  :global(html:not([data-theme='light'])) .care-badge {
    color: #9cc79a;
  }
  .care-badge i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
    animation: care-pulse 2s ease-in-out infinite;
  }
  @keyframes care-pulse {
    50% {
      box-shadow: 0 0 0 5px rgba(156, 199, 154, 0.25);
    }
  }
  .care-ico {
    color: var(--gold-bright);
  }
  .care-card b {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--text);
  }
  .care-card ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .care-card li {
    padding-left: 1.2rem;
    position: relative;
  }
  .care-card li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    border: 1px solid var(--gold);
  }
  .care-card li.on {
    color: var(--text);
    font-weight: 600;
  }
  .care-card li.on::before {
    background: var(--gold-bright);
    border-color: var(--gold-bright);
  }
  .care-card .go {
    position: absolute;
    right: 1.25rem;
    bottom: 1.25rem;
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--primary);
    color: #fff;
  }
  .proof {
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }
  .proof-label {
    text-align: center;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* Fondateur */
  .founder-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
    max-width: 62rem;
  }
  .f-photo {
    width: clamp(9rem, 18vw, 13rem);
    height: auto;
    aspect-ratio: 1;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--gold);
    box-shadow: 0 0 0 8px rgba(150, 114, 29, 0.12);
  }
  .founder-row blockquote {
    margin: 1rem 0 1.25rem;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    font-weight: 600;
    line-height: 1.35;
    color: var(--text);
  }
  .f-who {
    margin-bottom: 1rem;
    color: var(--muted);
  }
  .f-who b {
    color: var(--text);
  }
  .uni-card {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    border-radius: 1.5rem;
    border: 1px solid var(--line-strong);
    background: var(--card);
    transition:
      transform 0.4s var(--ease),
      border-color 0.4s var(--ease);
  }
  .uni-card:hover {
    transform: translateY(-6px);
    border-color: rgba(255, 210, 48, 0.45);
  }
  .uni-top {
    position: relative;
    height: 9.5rem;
    display: grid;
    place-items: center;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 130%, rgba(150, 114, 29, 0.55), transparent 62%),
      linear-gradient(180deg, var(--card-hover), var(--card));
  }
  .uni-ico {
    position: relative;
    z-index: 1;
    width: 5rem;
    height: 5rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: var(--gold-bright);
    background: rgba(var(--bg-rgb), 0.55);
    border: 1px solid rgba(255, 210, 48, 0.3);
    transition: transform 0.5s var(--ease);
  }
  .uni-card:hover .uni-ico {
    transform: scale(1.08) rotate(-4deg);
  }
  .uni-short {
    position: absolute;
    inset: auto 0 -1.7rem 0;
    text-align: center;
    font-size: 4.5rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 210, 48, 0.14);
  }
  .uni-body {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: 1.4rem 1.4rem 1.6rem;
  }
  .uni-body h3 {
    font-size: 1.35rem;
  }
  .uni-body p {
    font-size: 0.9rem;
    color: var(--muted);
    padding-right: 2rem;
  }
  .go {
    position: absolute;
    right: 1.25rem;
    bottom: 1.4rem;
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--primary);
    color: #fff;
    transition: transform 0.4s var(--ease);
  }
  .go :global(svg) {
    width: 0.95rem;
  }
  .uni-card:hover .go {
    transform: translateX(4px);
  }
  .map-row {
    max-width: 560px;
    margin: clamp(3rem, 6vw, 4.5rem) auto 0;
  }
  .center-link {
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  /* ANIMA */
  .anima {
    background: radial-gradient(ellipse 55% 60% at 50% 45%, rgba(150, 114, 29, 0.14), transparent 70%);
  }
  .anima-visual {
    max-width: 760px;
    margin: 0 auto;
  }
  .motto {
    list-style: none;
    margin: 2.5rem auto 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }
  .motto li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 1.1rem 0.55rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: var(--card);
    font-weight: 700;
  }
  .m-ico {
    width: 2.25rem;
    height: 2.25rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgba(150, 114, 29, 0.3);
    color: var(--gold-bright);
  }

  @media (max-width: 1080px) {
    .uni,
    .uni.uni-3 {
      grid-template-columns: repeat(2, 1fr);
    }
    .care-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .hero-visual {
      width: 220px;
    }
    .pillars {
      flex-direction: column;
      align-items: flex-start;
      max-width: 20rem;
      gap: 0.9rem;
    }
  }
  @media (max-width: 520px) {
    .uni,
    .uni.uni-3 {
      grid-template-columns: 1fr;
    }
    .founder-row {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }
    .uni-top {
      height: 8rem;
    }
  }
</style>
