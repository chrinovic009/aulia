---
import page from '../data/pages/legal.ts';
import { block } from '../data/site.ts';
import LegalPage from '../components/LegalPage.astro';
import type { Lang } from '../i18n.ts';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const T = block(Astro.locals, 'page:legal', lang, page);
---
<LegalPage lang={lang} route="legal" title={T.title} lead={T.lead} sections={T.sections} />
