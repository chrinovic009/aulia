---
import LegalPage from '../components/LegalPage.astro';
import type { Lang } from '../i18n.ts';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const P = lang === 'en' ? 'Information to be published.' : 'Information en cours de publication.';
const T = {
  en: {
    title: 'Legal notice',
    lead: 'Information about the publisher and hosting of this website.',
    sections: [
      { title: 'Publisher', text: P, pending: true },
      { title: 'Legal form and registration', text: P, pending: true },
      { title: 'Registered office', text: P, pending: true },
      { title: 'Publication director', text: P, pending: true },
      { title: 'Hosting', text: P, pending: true },
      { title: 'Intellectual property', text: 'The AULIA name, its logos, content and graphic elements are the property of AULIA. Any reproduction without prior authorisation is prohibited.' },
    ],
  },
  fr: {
    title: 'Mentions légales',
    lead: "Informations relatives à l'éditeur et à l'hébergement du site.",
    sections: [
      { title: 'Éditeur du site', text: P, pending: true },
      { title: 'Forme juridique et immatriculation', text: P, pending: true },
      { title: 'Siège', text: P, pending: true },
      { title: 'Directeur de la publication', text: P, pending: true },
      { title: 'Hébergement', text: P, pending: true },
      { title: 'Propriété intellectuelle', text: "Le nom AULIA, ses logos, ses contenus et ses éléments graphiques sont la propriété d'AULIA. Toute reproduction sans autorisation préalable est interdite." },
    ],
  },
}[lang];
---
<LegalPage lang={lang} route="legal" title={T.title} lead={T.lead} sections={T.sections} />
