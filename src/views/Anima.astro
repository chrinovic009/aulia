  /* états du cycle */
  .cycle[data-stage='0'] .w-in,
  .cycle[data-stage='1'] .w-mem,
  .cycle[data-stage='3'] .w-out,
  .cycle[data-stage='4'] .w-out,
  .cycle[data-stage='4'] .w-gov {
