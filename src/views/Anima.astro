---
import Layout from '../layouts/Layout.astro';
import Status from '../components/Status.astro';
import Icon from '../components/Icon.astro';
import Tiles from '../components/Tiles.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import { getContent } from '../data/site.ts';
import { path, type Lang } from '../i18n.ts';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const { anima } = getContent(lang);
const mod = Object.fromEntries(anima.modules.map((m) => [m.id, m]));

const T = {
  en: {
    meta: 'ANIMA, the transversal intelligence architecture envisioned by AULIA to perceive, understand, anticipate, coordinate and act across specialised systems.',
    h1: 'The intelligence <em>that moves the ecosystem.</em>',
    lead: 'Perceive, understand, anticipate, coordinate and act — under human control.',
    state: 'Long-term research programme',
    cycleEyebrow: 'How it thinks', cycleTitle: 'From perception <em>to action.</em>',
    stages: ['Receives text, voice, images, video and sensor data.', 'Interprets in context, drawing on memory.', 'Detects trends and risks ahead.', 'Coordinates the specialised systems.', 'Acts within its permissions, under validation.'],
    inputs: 'Inputs', systems: 'Systems', memory: 'Memory', validation: 'Validation', forecast: 'Forecast',
    capEyebrow: 'Capabilities', capTitle: 'Seven capabilities, <em>one core.</em>',
    archEyebrow: 'Architecture', archTitle: 'One pipeline, <em>framed by governance.</em>',
    archNote: 'Target architecture — no module is presented as implemented.',
    scEyebrow: 'Scenarios', scTitle: 'What it could <em>look like.</em>', scNote: 'Illustrative scenarios — not operations in production.',
    replay: 'Replay', scenario: 'Scenario',
    sovEyebrow: 'Sovereignty', sovTitle: 'Local, sovereign, <em>controlled.</em>',
    quote: 'A useful intelligence is also measured by <em>what it knows not to do.</em>',
    demo: 'Experience ANIMA', demoNote: 'Interactive demonstrations in preparation — synthetic data only.',
    ctaEyebrow: 'Research & partnerships', ctaTitle: 'Building ANIMA <em>with the right people.</em>',
    ctaLabel: 'Build with AULIA', ctaSecondary: 'Research & Innovation',
  },
  fr: {
    meta: "ANIMA, l'architecture d'intelligence transversale imaginée par AULIA pour percevoir, comprendre, anticiper, coordonner et agir à travers des systèmes spécialisés.",
    h1: "L'intelligence <em>qui anime l'écosystème.</em>",
    lead: 'Percevoir, comprendre, anticiper, coordonner et agir — sous contrôle humain.',
    state: 'Programme de recherche de long terme',
    cycleEyebrow: 'Comment elle pense', cycleTitle: "De la perception <em>à l'action.</em>",
    stages: ['Reçoit texte, voix, images, vidéo et capteurs.', 'Interprète en contexte, en s’appuyant sur la mémoire.', 'Détecte les tendances et les risques à venir.', 'Coordonne les systèmes spécialisés.', 'Agit dans ses autorisations, sous validation.'],
    inputs: 'Entrées', systems: 'Systèmes', memory: 'Mémoire', validation: 'Validation', forecast: 'Prévision',
    capEyebrow: 'Capacités', capTitle: 'Sept capacités, <em>un seul noyau.</em>',
    archEyebrow: 'Architecture', archTitle: 'Une chaîne, <em>encadrée par la gouvernance.</em>',
    archNote: "Architecture cible — aucun module n'est présenté comme implémenté.",
    scEyebrow: 'Scénarios', scTitle: 'À quoi cela <em>pourrait ressembler.</em>', scNote: 'Scénarios illustratifs — pas des opérations en production.',
    replay: 'Rejouer', scenario: 'Scénario',
    sovEyebrow: 'Souveraineté', sovTitle: 'Local, souverain, <em>maîtrisé.</em>',
    quote: "Une intelligence utile se mesure aussi à <em>ce qu'elle sait ne pas faire.</em>",
    demo: 'Expérience ANIMA', demoNote: 'Démonstrations interactives en préparation — données synthétiques uniquement.',
    ctaEyebrow: 'Recherche & partenariats', ctaTitle: 'Construire ANIMA <em>avec les bonnes personnes.</em>',
    ctaLabel: 'Construire avec AULIA', ctaSecondary: 'Recherche & Innovation',
  },
}[lang];

const mottoIcons = ['wave', 'message', 'trend', 'network', 'bolt'];
const capIcons = ['wave', 'message', 'database', 'branch', 'trend', 'network', 'bolt'];
const sovIcons = ['lock', 'server', 'offline', 'language', 'key', 'checklist'];
const scIcons: Record<string, string[]> = {
  A: ['mic', 'search', 'file', 'alert', 'user'],
  B: ['camera', 'search', 'box', 'eye', 'send'],
  C: ['trend', 'chart', 'database', 'transform', 'check'],
};
const sov = anima.sovereignty.map((s, i) => ({ icon: sovIcons[i], title: s.title, text: s.text }));

// Schéma du cycle (viewBox 900 × 460)
const inputs = [
  { icon: 'mic', y: 70 }, { icon: 'camera', y: 150 }, { icon: 'file', y: 230 }, { icon: 'activity', y: 310 }, { icon: 'message', y: 390 },
];
const systems = [{ n: 'CARE', y: 120 }, { n: 'VIGIL', y: 190 }, { n: 'FLOW', y: 260 }, { n: 'VR', y: 330 }];

// Orbite des capacités
const orbit = anima.capabilities.map((c, i) => {
  const a = ((i * 360) / anima.capabilities.length - 90) * (Math.PI / 180);
  return { ...c, icon: capIcons[i], x: 50 + 41 * Math.cos(a), y: 50 + 41 * Math.sin(a) };
});
---

<Layout lang={lang} route="anima" title="ANIMA" description={T.meta}>
  <!-- HERO : orbe interactive -->
  <section class="hero">
    <div class="blobs" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div class="hero-text">
        <p class="eyebrow">ANIMA</p>
        <h1 class="display display-l" set:html={T.h1} />
        <p class="lead">{T.lead}</p>
        <ul class="pills">
          {anima.motto.map((m, i) => <li><Icon name={mottoIcons[i]} size={16} />{m}</li>)}
        </ul>
        <div class="state"><Status status={anima.status} lang={lang} /><span>{T.state}</span></div>
      </div>
      <div class="orb-wrap" data-orb aria-hidden="true">
        <div class="orb" data-orb-inner>
          <span class="ring rg1"></span>
          <span class="ring rg2"></span>
          <span class="ring rg3"></span>
          <span class="spin sp1"><i></i></span>
          <span class="spin sp2"><i></i></span>
          <span class="spin sp3"><i></i></span>
          <span class="orb-core"><span class="core-light"></span></span>
          <span class="orb-label">ANIMA</span>
        </div>
      </div>
    </div>
  </section>

  <!-- CYCLE interactif -->
  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={T.cycleEyebrow} title={T.cycleTitle} center />
      <div class="cycle reveal" data-cycle data-stage="0" data-texts={JSON.stringify(T.stages)}>
        <div class="cy-steps" role="tablist">
          {anima.motto.map((m, i) => (
            <button type="button" role="tab" class="cy-step" data-step={i} aria-selected={i === 0 ? 'true' : 'false'}>
              <span class="cy-ico"><Icon name={mottoIcons[i]} size={18} /></span>{m}
            </button>
          ))}
        </div>
        <div class="cy-bar"><i data-cy-bar></i></div>

        <div class="cy-scroll"><svg class="cy-svg" viewBox="0 0 900 460" role="img" aria-label={anima.motto.join(' → ')}>
          <defs>
            <radialGradient id="cy-core" cx="0.5" cy="0.4" r="0.6">
              <stop offset="0" stop-color="#ffe9a8" />
              <stop offset="0.45" stop-color="#c6a45c" />
              <stop offset="1" stop-color="#3a2a0b" />
            </radialGradient>
            <radialGradient id="cy-halo" cx="0.5" cy="0.5" r="0.5">
              <stop offset="0" stop-color="#ffd230" stop-opacity="0.35" />
              <stop offset="1" stop-color="#ffd230" stop-opacity="0" />
            </radialGradient>
          </defs>

          <text x="90" y="30" class="cy-cap" text-anchor="middle">{T.inputs}</text>
          <text x="790" y="80" class="cy-cap" text-anchor="middle">{T.systems}</text>

          <!-- fils d'entrée -->
          {inputs.map((n) => <path class="wire w-in" d={`M116 ${n.y} C 260 ${n.y}, 300 230, 394 230`} />)}
          <!-- fils de sortie -->
          {systems.map((s) => <path class="wire w-out" d={`M506 230 C 600 230, 640 ${s.y}, 735 ${s.y}`} />)}
          <path class="wire w-mem" d="M450 174 L450 92" />
          <path class="wire w-gov" d="M450 286 L450 368" />

          <!-- entrées -->
          {inputs.map((n) => (
            <g class="node n-in">
              <circle cx="90" cy={n.y} r="26" />
              <g transform={`translate(78 ${n.y - 12})`}><Icon name={n.icon} size={24} /></g>
            </g>
          ))}

          <!-- mémoire -->
          <g class="node n-mem">
            <circle cx="450" cy="66" r="26" />
            <g transform="translate(438 54)"><Icon name="database" size={24} /></g>
            <text x="492" y="71" class="cy-lbl">{T.memory}</text>
          </g>

          <!-- validation humaine / gouvernance -->
          <g class="node n-gov">
            <circle cx="450" cy="394" r="26" />
            <g transform="translate(438 382)"><Icon name="shield-check" size={24} /></g>
            <text x="492" y="399" class="cy-lbl">{T.validation}</text>
          </g>

          <!-- prévision -->
          <g class="trend">
            <rect x="560" y="18" width="170" height="70" rx="14" />
            <text x="576" y="40" class="cy-lbl small">{T.forecast}</text>
            <polyline points="578,74 600,66 622,70 644,56 666,58 688,44 712,36" pathLength="1" />
          </g>

          <!-- systèmes -->
          {systems.map((s) => (
            <g class="node n-sys">
              <rect x="735" y={s.y - 20} width="112" height="40" rx="20" />
              <text x="791" y={s.y + 5} text-anchor="middle">{s.n}</text>
              <g class="tick"><circle cx="847" cy={s.y - 20} r="9" /><path d={`M842 ${s.y - 20} l3 3 l6 -6`} /></g>
            </g>
          ))}

          <!-- noyau -->
          <circle cx="450" cy="230" r="120" fill="url(#cy-halo)" class="halo" />
          <circle cx="450" cy="230" r="78" class="core-ring cr1" />
          <circle cx="450" cy="230" r="66" class="core-ring cr2" />
          <circle cx="450" cy="230" r="54" class="core-ball" fill="url(#cy-core)" />
          <text x="450" y="236" text-anchor="middle" class="core-txt">ANIMA</text>
        </svg></div>

        <p class="cy-caption" data-cy-caption aria-live="polite">{T.stages[0]}</p>
      </div>
    </div>
  </section>

  <!-- ORBITE des capacités -->
  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={T.capEyebrow} title={T.capTitle} center />
      <div class="orbit reveal" data-orbit>
        <span class="o-ring" aria-hidden="true"></span>
        <div class="o-center">
          {orbit.map((c, i) => (
            <div class:list={['o-card', { on: i === 0 }]} data-card={i}>
              <span class="o-big"><Icon name={c.icon} size={30} /></span>
              <h3>{c.name}</h3>
              <p>{c.text}</p>
            </div>
          ))}
        </div>
        {orbit.map((c, i) => (
          <button
            type="button"
            class:list={['o-node', { on: i === 0 }]}
            style={`left:${c.x.toFixed(2)}%;top:${c.y.toFixed(2)}%`}
            data-node={i}
            aria-label={c.name}
          >
            <span class="o-ico"><Icon name={c.icon} size={22} /></span>
            <span class="o-name">{c.name}</span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- ARCHITECTURE -->
  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={T.archEyebrow} title={T.archTitle} lead={T.archNote} center />
      <div class="pipe reveal">
        <span class="pipe-label"><Icon name="shield-check" size={14} />{mod.governance.name} — {mod.governance.role}</span>
        <div class="pipe-track" aria-hidden="true"><i></i></div>
        <ol class="pipe-row">
          <li class="pm"><span class="pm-ico"><Icon name="wave" size={22} /></span><b>{mod.perception.name}</b><small>{mod.perception.role}</small></li>
          <li class="pm stack">
            <div><span class="pm-ico sm"><Icon name="database" size={18} /></span><b>{mod.memory.name}</b></div>
            <div><span class="pm-ico sm"><Icon name="branch" size={18} /></span><b>{mod.reasoning.name}</b></div>
          </li>
          <li class="pm core"><span class="pm-ico"><Icon name="network" size={24} /></span><b>{mod.core.name}</b><small>{mod.core.role}</small></li>
          <li class="pm"><span class="pm-ico"><Icon name="branch" size={22} /></span><b>{mod.orchestrator.name}</b><small>{mod.orchestrator.role}</small></li>
          <li class="pm"><span class="pm-ico"><Icon name="bolt" size={22} /></span><b>{mod.action.name}</b><small>{mod.action.role}</small></li>
        </ol>
      </div>
    </div>
  </section>

  <!-- SCÉNARIOS -->
  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={T.scEyebrow} title={T.scTitle} lead={T.scNote} center />
      <div class="scen reveal" data-scen>
        <div class="sc-tabs" role="tablist">
          {anima.scenarios.map((s, i) => (
            <button type="button" role="tab" class="sc-tab" data-tab={i} aria-selected={i === 0 ? 'true' : 'false'}>
              <span class="sc-letter">{s.id}</span>
              <span class="sc-t">{s.title}</span>
            </button>
          ))}
        </div>
        {anima.scenarios.map((s, i) => (
          <div class:list={['sc-panel', { on: i === 0 }]} data-panel={i}>
            <p class="sc-ctx"><span class="sc-sys">ANIMA + {s.systems.join(' + ')}</span>{s.context}</p>
            <ol class="sc-flow" style={`--n:${s.steps.length}`}>
              {s.steps.map((st, j) => (
                <li style={`--j:${j}`}>
                  <span class="sc-node"><Icon name={scIcons[s.id][j]} size={22} /></span>
                  <span class="sc-step">{st}</span>
                </li>
              ))}
            </ol>
            <p class="sc-guard"><Icon name="shield" size={16} />{s.guard}</p>
          </div>
        ))}
        <button type="button" class="sc-replay" data-replay><Icon name="transform" size={16} />{T.replay}</button>
      </div>
    </div>
  </section>

  <!-- SOUVERAINETÉ -->
  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={T.sovEyebrow} title={T.sovTitle} center />
      <Tiles items={sov} cols={3} lang={lang} compact />
    </div>
  </section>

  <!-- CITATION -->
  <section class="section quote-sec">
    <div class="wrap reveal">
      <blockquote set:html={T.quote} />
      <div class="demo">
        <span class="btn btn-ghost" aria-disabled="true"><Icon name="play" size={16} />{T.demo}</span>
        <span class="muted">{T.demoNote}</span>
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow={T.ctaEyebrow}
    title={T.ctaTitle}
    href={path(lang, 'partnerships')}
    label={T.ctaLabel}
    secondary={{ href: path(lang, 'research'), label: T.ctaSecondary }}
  />
</Layout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    min-height: 92svh;
    display: grid;
    align-items: center;
    padding-top: 7rem;
    padding-bottom: 4rem;
    overflow: hidden;
  }
  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .hero h1 {
    margin-top: 1.25rem;
  }
  .hero .lead {
    margin-top: 1.25rem;
  }
  .pills {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .pills li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: var(--card);
    font-size: 0.85rem;
    font-weight: 600;
  }
  .pills :global(svg) {
    color: var(--gold-bright);
  }
  .state {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: center;
    font-size: 0.85rem;
    color: var(--faint);
  }

  /* Orbe */
  .orb-wrap {
    perspective: 900px;
    display: grid;
    place-items: center;
  }
  .orb {
    position: relative;
    width: min(100%, 460px);
    aspect-ratio: 1;
    transform-style: preserve-3d;
    transition: transform 0.6s var(--ease);
  }
  .ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid rgba(255, 210, 48, 0.25);
  }
  .rg1 {
    border-style: dashed;
    animation: spin 40s linear infinite;
  }
  .rg2 {
    inset: 12%;
    border-color: rgba(255, 255, 255, 0.08);
    animation: spin 26s linear infinite reverse;
  }
  .rg3 {
    inset: 24%;
    border: 1px dotted rgba(255, 210, 48, 0.4);
    animation: spin 18s linear infinite;
  }
  .spin {
    position: absolute;
    inset: 6%;
    border-radius: 50%;
    animation: spin 9s linear infinite;
  }
  .spin i {
    position: absolute;
    top: -5px;
    left: 50%;
    width: 10px;
    height: 10px;
    margin-left: -5px;
    border-radius: 50%;
    background: #ffd230;
    box-shadow: 0 0 18px 4px rgba(255, 210, 48, 0.7);
  }
  .sp2 {
    inset: 18%;
    animation-duration: 6s;
    animation-direction: reverse;
  }
  .sp2 i {
    background: #fff;
    width: 6px;
    height: 6px;
    margin-left: -3px;
    top: -3px;
    box-shadow: 0 0 12px 3px rgba(255, 255, 255, 0.6);
  }
  .sp3 {
    inset: 30%;
    animation-duration: 4s;
  }
  .sp3 i {
    width: 7px;
    height: 7px;
    margin-left: -3.5px;
  }
  .orb-core {
    position: absolute;
    inset: 36%;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 35%, #fff4cc 0%, #ffd230 22%, #c6a45c 48%, #5a4210 78%, #1e1608 100%);
    box-shadow:
      0 0 60px 10px rgba(255, 210, 48, 0.35),
      0 0 140px 40px rgba(150, 114, 29, 0.25);
    animation: breathe 3.2s ease-in-out infinite;
  }
  .core-light {
    position: absolute;
    inset: 20%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.9), transparent 70%);
    filter: blur(6px);
    animation: wander 7s ease-in-out infinite;
  }
  .orb-label {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.5rem;
    text-align: center;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.4em;
    color: var(--gold-bright);
  }

  /* ---------- Cycle ---------- */
  .cycle {
    border-radius: 2rem;
    border: 1px solid var(--line-strong);
    background: radial-gradient(ellipse at 50% 50%, rgba(150, 114, 29, 0.12), transparent 65%), var(--card);
    padding: clamp(1.25rem, 3vw, 2rem);
  }
  .cy-steps {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }
  .cy-step {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem 0.4rem 0.4rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: rgba(17, 16, 13, 0.5);
    color: #d1d5dc;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition:
      background 0.3s var(--ease),
      border-color 0.3s var(--ease),
      color 0.3s var(--ease);
  }
  .cy-ico {
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgba(150, 114, 29, 0.25);
    color: var(--gold-bright);
  }
  .cy-step[aria-selected='true'] {
    background: var(--primary);
    border-color: var(--primary);
    color: #fff;
  }
  .cy-step[aria-selected='true'] .cy-ico {
    background: rgba(255, 255, 255, 0.18);
    color: #fff;
  }
  .cy-bar {
    height: 2px;
    margin: 1.25rem auto 0;
    max-width: 30rem;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }
  .cy-bar i {
    display: block;
    height: 100%;
    width: 100%;
    background: linear-gradient(90deg, var(--primary), var(--gold-bright));
    transform-origin: left;
    transform: scaleX(0);
  }
  .cy-bar i.run {
    animation: fill 3.6s linear forwards;
  }
  .cy-svg {
    width: 100%;
    height: auto;
    margin-top: 1rem;
    overflow: visible;
  }
  .cy-cap {
    fill: var(--faint);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .cy-lbl {
    fill: #d1d5dc;
    font-size: 14px;
    font-weight: 600;
  }
  .cy-lbl.small {
    fill: var(--muted);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .wire {
    fill: none;
    stroke: #364153;
    stroke-width: 1.5;
    stroke-dasharray: 5 7;
    transition:
      stroke 0.4s ease,
      opacity 0.4s ease;
  }
  .node circle,
  .node rect {
    fill: #17202d;
    stroke: #364153;
    stroke-width: 1.5;
    transition:
      fill 0.4s ease,
      stroke 0.4s ease;
  }
  .node :global(svg) {
    color: var(--muted);
    transition: color 0.4s ease;
  }
  .n-sys text {
    fill: #e5e7eb;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.18em;
  }
  .tick {
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .tick circle {
    fill: #3f8f5a;
    stroke: none;
  }
  .tick path {
    fill: none;
    stroke: #fff;
    stroke-width: 2;
  }
  .trend {
    opacity: 0.25;
    transition: opacity 0.5s ease;
  }
  .trend rect {
    fill: #17202d;
    stroke: #364153;
  }
  .trend polyline {
    fill: none;
    stroke: #ffd230;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .halo {
    opacity: 0.6;
