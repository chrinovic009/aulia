---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Tiles from '../components/Tiles.astro';
import Timeline from '../components/Timeline.astro';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { getContent } from '../data/site.ts';
import { path, contactPath, type Lang } from '../i18n.ts';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const { purpose, name, doctrine } = getContent(lang);
const doctrineIcons = ['search', 'radar', 'bulb', 'shield', 'transform'];

const T = {
  en: {
    meta: 'What AULIA is, why it exists, how it thinks and what it sets out to build.',
    eyebrow: 'Our vision',
    title: 'Building an institution, <em>not just companies.</em>',
    lead: 'A parent company that designs, holds and grows specialised technology companies — united by one doctrine.',
    nameEyebrow: 'The name',
    nameTitle: 'Gold. Light. <em>A soul that acts.</em>',
    pmvEyebrow: 'Why we exist',
    pmvTitle: 'Purpose, mission, <em>vision.</em>',
    pmv: ['Purpose', 'Mission', 'Vision'],
    docEyebrow: 'Doctrine',
    docTitle: 'Five verbs <em>for every decision.</em>',
    valEyebrow: 'Values',
    valTitle: 'What we will <em>never trade.</em>',
    values: [
      { icon: 'gem', title: 'Integrity', text: 'before growth' },
      { icon: 'shield-check', title: 'Security', text: 'before speed' },
      { icon: 'sun', title: 'Truth', text: 'before image' },
      { icon: 'badge', title: 'Proof', text: 'before promise' },
    ],
    pathEyebrow: 'Development',
    pathTitle: 'Prove <em>before scaling.</em>',
    path: [
      { icon: 'medical', title: 'First foundation', text: 'AULIA Care in the field' },
      { icon: 'factory', title: 'Industrial value', text: 'Vigil & Flow' },
      { icon: 'flask', title: 'Scientific mastery', text: 'Our own systems, including ANIMA' },
      { icon: 'expand', title: 'A wider ecosystem', text: 'Each company earns its place' },
    ],
    govEyebrow: 'Governance',
    govTitle: 'Built <em>to outlast its founders.</em>',
    gov: [
      { icon: 'key', title: 'Protect intellectual property' },
      { icon: 'expand', title: 'Create new companies' },
      { icon: 'link', title: 'Strategic partnerships' },
      { icon: 'layers', title: 'Shared resources, autonomous subsidiaries' },
      { icon: 'users', title: 'Governance beyond the founders' },
      { icon: 'book', title: 'A doctrine across generations' },
    ],
    govNote: 'Governance bodies will be published once formally approved.',
    quote: 'We will not try to look big. We will accumulate enough proof that, one day, our greatness becomes <em>hard to dispute.</em>',
    ctaEyebrow: 'Ecosystem',
    ctaTitle: 'Discover <em>the group’s companies.</em>',
    ctaLabel: 'Explore the ecosystem',
    ctaSecondary: 'Request a presentation',
  },
  fr: {
    meta: "Ce qu'est AULIA, pourquoi elle existe, comment elle pense et ce qu'elle cherche à construire.",
    eyebrow: 'Notre vision',
    title: 'Construire une institution, <em>pas seulement des entreprises.</em>',
    lead: 'Une société mère qui conçoit, détient et fait grandir des entreprises technologiques spécialisées — unies par une même doctrine.',
    nameEyebrow: 'Le nom',
    nameTitle: "L'or. La lumière. <em>Une âme qui agit.</em>",
    pmvEyebrow: 'Pourquoi nous existons',
    pmvTitle: "Raison d'être, mission, <em>vision.</em>",
    pmv: ["Raison d'être", 'Mission', 'Vision'],
    docEyebrow: 'Doctrine',
    docTitle: 'Cinq verbes <em>pour chaque décision.</em>',
    valEyebrow: 'Valeurs',
    valTitle: 'Ce que nous ne sacrifierons <em>jamais.</em>',
    values: [
      { icon: 'gem', title: "L'intégrité", text: 'avant la croissance' },
      { icon: 'shield-check', title: 'La sécurité', text: 'avant la rapidité' },
      { icon: 'sun', title: 'La vérité', text: "avant l'image" },
      { icon: 'badge', title: 'La preuve', text: 'avant la promesse' },
    ],
    pathEyebrow: 'Développement',
    pathTitle: 'Prouver <em>avant de grandir.</em>',
    path: [
      { icon: 'medical', title: 'Premier socle', text: 'AULIA Care sur le terrain' },
      { icon: 'factory', title: 'Valeur industrielle', text: 'Vigil & Flow' },
      { icon: 'flask', title: 'Maîtrise scientifique', text: 'Nos propres systèmes, dont ANIMA' },
      { icon: 'expand', title: 'Un écosystème élargi', text: 'Chaque entreprise mérite sa place' },
    ],
    govEyebrow: 'Gouvernance',
    govTitle: 'Pensée <em>pour survivre à ses fondateurs.</em>',
    gov: [
      { icon: 'key', title: 'Protéger la propriété intellectuelle' },
      { icon: 'expand', title: 'Créer de nouvelles entreprises' },
      { icon: 'link', title: 'Partenariats stratégiques' },
      { icon: 'layers', title: 'Ressources partagées, filiales autonomes' },
      { icon: 'users', title: 'Une gouvernance au-delà des fondateurs' },
      { icon: 'book', title: 'Une doctrine à travers les générations' },
    ],
    govNote: 'Les organes de gouvernance seront publiés une fois formellement validés.',
    quote: "Nous ne chercherons pas à paraître grands. Nous accumulerons assez de preuves pour qu'un jour, notre grandeur devienne <em>difficile à contester.</em>",
    ctaEyebrow: 'Écosystème',
    ctaTitle: 'Découvrir <em>les entreprises du groupe.</em>',
    ctaLabel: "Explorer l'écosystème",
    ctaSecondary: 'Demander une présentation',
  },
}[lang];

const pmvIcons = ['spark', 'target', 'compass'];
const pmvTexts = [purpose.raison, purpose.mission, purpose.vision];
const doctrineTiles = doctrine.map((d, i) => ({ icon: doctrineIcons[i], title: d.word, text: d.short }));
---

<Layout lang={lang} route="vision" title={T.eyebrow} description={T.meta}>
  <PageHero eyebrow={T.eyebrow} title={T.title} lead={T.lead} />

  <!-- Le nom -->
  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={T.nameEyebrow} title={T.nameTitle} center />
      <ol class="name">
        {name.map((n, i) => (
          <li class="reveal" style={`transition-delay:${i * 100}ms`}>
            <span class="letters">{n.letters}</span>
            <span class="latin">{n.latin}</span>
            <h3>{n.title}</h3>
          </li>
        ))}
      </ol>
      <p class="equation reveal" aria-hidden="true"><span>AU</span>+<span>LI</span>+<span>A</span>=<img src="/images/aulia-mark.png" alt="" width="186" height="185" /></p>
    </div>
  </section>

  <!-- Raison d'être / mission / vision -->
  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={T.pmvEyebrow} title={T.pmvTitle} center />
      <div class="pmv">
        {T.pmv.map((label, i) => (
          <article class="reveal" style={`transition-delay:${i * 100}ms`}>
            <span class="pmv-ico"><Icon name={pmvIcons[i]} size={28} /></span>
            <h3>{label}</h3>
            <p>{pmvTexts[i]}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Doctrine -->
  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={T.docEyebrow} title={T.docTitle} center />
      <Tiles items={doctrineTiles} cols={5} lang={lang} center />
    </div>
  </section>

  <!-- Valeurs -->
  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={T.valEyebrow} title={T.valTitle} center />
      <Tiles items={T.values} cols={4} lang={lang} center />
    </div>
  </section>

  <!-- Développement -->
  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={T.pathEyebrow} title={T.pathTitle} center />
      <Timeline items={T.path} />
    </div>
  </section>

  <!-- Gouvernance -->
  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={T.govEyebrow} title={T.govTitle} center />
      <Tiles items={T.gov} cols={3} lang={lang} compact />
      <p class="gov-note reveal">{T.govNote}</p>
    </div>
  </section>

  <!-- Ambition -->
  <section class="section quote-sec">
    <div class="wrap reveal">
      <img src="/images/aulia-mark.png" alt="" width="186" height="185" class="q-mark" />
      <blockquote set:html={T.quote} />
    </div>
  </section>

  <CtaBand
    eyebrow={T.ctaEyebrow}
    title={T.ctaTitle}
    href={path(lang, 'ecosystem')}
    label={T.ctaLabel}
    secondary={{ href: contactPath(lang, 'presentation'), label: T.ctaSecondary }}
  />
</Layout>

<style>
  .name {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .name li {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 0.4rem;
    padding: 2.5rem 1.5rem;
    border-radius: 1.5rem;
    border: 1px solid var(--line-strong);
    background: radial-gradient(circle at 50% 0%, rgba(150, 114, 29, 0.3), transparent 60%), var(--card);
  }
  .letters {
    font-size: clamp(4.5rem, 9vw, 7rem);
    font-weight: 800;
    line-height: 0.95;
    background: linear-gradient(180deg, #ffe08a, #c6a45c 60%, #8f6c27);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .latin {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .name h3 {
    font-size: 1.25rem;
  }
  .equation {
    margin-top: 2.5rem;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    font-size: 1.5rem;
    font-weight: 300;
    color: var(--faint);
  }
  .equation span {
    font-weight: 800;
    color: var(--gold-bright);
  }
  .equation img {
    width: 3.5rem;
    height: auto;
  }
  .pmv {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .pmv article {
    display: grid;
    align-content: start;
    gap: 0.9rem;
    padding: 2rem 1.75rem;
    border-radius: 1.5rem;
    border: 1px solid var(--line-strong);
    background: var(--card);
  }
  .pmv-ico {
    width: 3.5rem;
    height: 3.5rem;
    display: grid;
    place-items: center;
    border-radius: 1rem;
    background: linear-gradient(145deg, rgba(150, 114, 29, 0.4), rgba(150, 114, 29, 0.08));
    color: var(--gold-bright);
  }
  .pmv h3 {
    font-size: 1.3rem;
    color: var(--gold-bright);
  }
  .pmv p {
    color: #d1d5dc;
    font-size: 0.98rem;
  }
  .gov-note {
    margin-top: 1.75rem;
    text-align: center;
    font-size: 0.85rem;
    color: var(--faint);
  }
  .quote-sec .wrap {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 2rem;
  }
  .q-mark {
    width: 4.5rem;
    height: auto;
  }
  blockquote {
    margin: 0;
    max-width: 50rem;
    font-size: clamp(1.6rem, 3.2vw, 2.6rem);
    font-weight: 700;
    line-height: 1.25;
  }
  blockquote :global(em) {
    color: var(--gold-bright);
  }
  @media (max-width: 860px) {
    .name,
    .pmv {
      grid-template-columns: 1fr;
    }
  }
</style>
