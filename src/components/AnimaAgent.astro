---
// ANIMA — agent Aulia : orbe en bas à droite, conversation texte et voix.
// Le cerveau tourne dans le site lui-même (src/lib/server/anima, routes /api/anima/…),
// avec un moteur de langage externe configuré par ANIMA_LLM_API_KEY.
// Sans moteur configuré ou injoignable, l'orbe passe en « veille » : le visiteur laisse un
// message, envoyé par le formulaire de contact du site (/api/contact).
import { path, type Lang } from '../i18n.ts';

interface Props { lang: Lang }
const { lang } = Astro.props;
---

<script
  is:inline
  src="/scripts/anima-widget.js"
  data-api=""
  data-chat="/api/anima/chat"
  data-health="/api/anima/health"
  data-contact="/api/contact"
  data-privacy={path(lang, 'privacy')}
  data-lang={lang}
  defer
></script>
