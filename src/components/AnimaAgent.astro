---
// Agent Aulia d'ANIMA : orbe en bas à droite + conversation texte et voix.
// Le widget est servi par le site (/scripts/anima-widget.js, copie du projet « Anima »).
// Si ANIMA est injoignable (ou PUBLIC_ANIMA_API_URL vide), l'orbe passe en « veille » :
// le visiteur laisse un message, envoyé par le formulaire de contact du site (/api/contact).
import { path, type Lang } from '../i18n.ts';

interface Props { lang: Lang }
const { lang } = Astro.props;
const api = (import.meta.env.PUBLIC_ANIMA_API_URL || '').replace(/\/$/, '');
---

<script
  is:inline
  src="/scripts/anima-widget.js"
  data-api={api || 'aucune'}
  data-contact="/api/contact"
  data-privacy={path(lang, 'privacy')}
  data-lang={lang}
  defer
></script>
