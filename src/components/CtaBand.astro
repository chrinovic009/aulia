---
import Arrow from './Arrow.astro';
interface Props { eyebrow?: string; title: string; text?: string; href: string; label: string; secondary?: { href: string; label: string }; }
const { eyebrow, title, text, href, label, secondary } = Astro.props;
---
<section class="section cta">
  <div class="wrap inner reveal">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 class="display display-l" set:html={title} />
    {text && <p class="lead">{text}</p>}
    <div class="actions">
      <a class="btn btn-primary" href={href}>{label}<Arrow /></a>
      {secondary && <a class="btn btn-ghost" href={secondary.href}>{secondary.label}</a>}
    </div>
  </div>
</section>

<style>
  .cta {
    text-align: center;
    background: radial-gradient(ellipse 50% 60% at 50% 100%, rgba(150, 114, 29, 0.18), transparent 70%);
  }
  .inner { display: grid; justify-items: center; gap: 1.5rem; }
  .lead { margin-inline: auto; }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem; margin-top: 1rem; }
</style>
