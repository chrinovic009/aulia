---
/** Frise horizontale (verticale sur mobile) : étapes reliées par un fil doré. */
import Icon from './Icon.astro';
interface Item { icon: string; title: string; text?: string; }
interface Props { items: Item[]; }
const { items } = Astro.props;
---

<ol class="tl reveal" style={`--n:${items.length}`}>
  {items.map((it, i) => (
    <li style={`--i:${i}`}>
      <span class="node"><Icon name={it.icon} size={24} /><b>{String(i + 1).padStart(2, '0')}</b></span>
      <h3>{it.title}</h3>
      {it.text && <p>{it.text}</p>}
    </li>
  ))}
</ol>

<style>
  .tl {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: 1.5rem;
  }
  .tl::before {
    content: '';
    position: absolute;
    top: 2rem;
    left: calc(50% / var(--n));
    right: calc(50% / var(--n));
    height: 2px;
    background: linear-gradient(90deg, var(--primary), var(--gold-bright), var(--primary));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 1.4s var(--ease) 0.2s;
  }
  .tl.is-visible::before,
  :global(.no-js) .tl::before {
    transform: scaleX(1);
  }
  li {
    position: relative;
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 0.5rem;
  }
  .node {
    position: relative;
    width: 4rem;
    height: 4rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--card);
    border: 2px solid var(--gold-bright);
    color: var(--gold-bright);
    box-shadow: 0 0 0 8px var(--black);
    margin-bottom: 0.75rem;
  }
  .node b {
    position: absolute;
    top: -0.4rem;
    right: -0.4rem;
    min-width: 1.6rem;
    height: 1.6rem;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: var(--primary);
    color: #fff;
    font-size: 0.68rem;
    font-weight: 700;
  }
  h3 {
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.25;
  }
  p {
    font-size: 0.88rem;
    color: var(--muted);
    max-width: 16rem;
  }
  @media (max-width: 820px) {
    .tl {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
    .tl::before {
      top: 2rem;
      bottom: 2rem;
      left: 2rem;
      right: auto;
      width: 2px;
      height: auto;
      transform-origin: top;
      background: linear-gradient(180deg, var(--primary), var(--gold-bright), var(--primary));
      transform: scaleY(0);
    }
    .tl.is-visible::before {
      transform: scaleY(1);
    }
    li {
      grid-template-columns: 4rem 1fr;
      justify-items: start;
      text-align: left;
      column-gap: 1.25rem;
      row-gap: 0.25rem;
    }
    .node {
      grid-row: span 2;
      margin: 0;
    }
    h3 {
      align-self: end;
    }
  }
</style>
