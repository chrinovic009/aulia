---
import { getContent } from '../data/site.ts';
import { ui, type Lang } from '../i18n.ts';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const { doctrine } = getContent(lang);
---

<div class="doctrine" data-doctrine>
  <div class="tabs" role="tablist" aria-label={ui[lang].doctrineLabel}>
    {doctrine.map((d, i) => (
      <button
        type="button"
        role="tab"
        id={`doc-tab-${i}`}
        aria-controls={`doc-panel-${i}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
        class="tab"
      >
        <span class="index">{String(i + 1).padStart(2, '0')}</span>
        <span class="word">{d.word}</span>
        <span class="short">{d.short}</span>
      </button>
    ))}
  </div>

  <div class="panels">
    {doctrine.map((d, i) => (
      <div role="tabpanel" id={`doc-panel-${i}`} aria-labelledby={`doc-tab-${i}`} class:list={['panel', { on: i === 0 }]}>
        <p class="en">{d.en}</p>
        <p class="long">{d.long}</p>
      </div>
    ))}
  </div>
</div>

<style>
  .tabs {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    border: 1px solid var(--line-strong);
    border-radius: 1.5rem;
    overflow: hidden;
    background: var(--card);
  }
  .tab {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.9rem;
    text-align: left;
    padding: 2rem 1.5rem;
    background: none;
    transition: background 0.4s var(--ease);
    border: 0;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .tab + .tab {
    border-left: 1px solid var(--line-strong);
  }
  .tab[aria-selected='true'] {
    background: var(--card-hover);
  }
  .tab::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--gold-bright);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--ease);
  }
  .tab[aria-selected='true']::before {
    transform: scaleX(1);
  }
  .word {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.9vw, 1.6rem);
    font-weight: 700;
    line-height: 1.1;
    color: #99a1af;
    transition: color 0.4s var(--ease);
  }
  .tab[aria-selected='true'] .word,
  .tab:hover .word {
    color: var(--ivory);
  }
  .tab[aria-selected='true'] .index {
    color: var(--gold);
  }
  .short {
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--muted);
  }

  .panels {
    position: relative;
    margin-top: 1rem;
    min-height: 6rem;
  }
  .panel {
    display: none;
    grid-template-columns: 12rem 1fr;
    gap: 2rem;
    padding: 2rem 0 0;
    border-top: 1px solid var(--line);
    animation: in 0.6s var(--ease);
  }
  .panel.on,
  :global(.no-js) .panel {
    display: grid;
  }
  .en {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold);
    padding-top: 0.4rem;
  }
  .long {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1.7vw, 1.45rem);
    font-weight: 500;
    line-height: 1.5;
    color: #e5e7eb;
    max-width: 44rem;
  }
  @keyframes in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  @media (max-width: 900px) {
    .tabs {
      grid-template-columns: 1fr;
    }
    .tab,
    .tab + .tab {
      padding: 1.25rem 1.25rem;
      border-left: 0;
      border-bottom: 1px solid var(--line-strong);
      grid-template-columns: 2.5rem 1fr;
      gap: 0.25rem 0;
    }
    .short {
      grid-column: 2;
    }
    .panels {
      display: none;
    }
  }
</style>

<script>
  document.querySelectorAll('[data-doctrine]').forEach((root) => {
    const tabs = [...root.querySelectorAll('[role="tab"]')];
    const panels = [...root.querySelectorAll('[role="tabpanel"]')];
    const select = (i, focus = false) => {
      tabs.forEach((t, j) => {
        t.setAttribute('aria-selected', String(i === j));
        t.setAttribute('tabindex', i === j ? '0' : '-1');
      });
      panels.forEach((p, j) => p.classList.toggle('on', i === j));
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('mouseenter', () => {
        if (window.matchMedia('(hover: hover)').matches) select(i);
      });
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') { e.preventDefault(); select((i + 1) % tabs.length, true); }
        if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') { e.preventDefault(); select((i - 1 + tabs.length) % tabs.length, true); }
      });
    });
  });
</script>
