---
interface Props { eyebrow?: string; title: string; lead?: string; center?: boolean; }
const { eyebrow, title, lead, center = false } = Astro.props;
---
<div class:list={['sh', 'reveal', { center }]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 class="display display-l" set:html={title} />
  {lead && <p class="lead">{lead}</p>}
</div>
<style>
  .sh {
    display: grid;
    gap: 1rem;
    max-width: 50rem;
    margin-bottom: clamp(2.5rem, 5vw, 3.75rem);
  }
  .center {
    margin-inline: auto;
    justify-items: center;
    text-align: center;
  }
  .center .lead {
    margin-inline: auto;
  }
</style>
