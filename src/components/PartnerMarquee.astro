---
/**
 * Bandeau animé des partenaires : les logos défilent en continu de gauche à droite,
 * chaque logo ouvre le site du partenaire. Pause au survol, défilement arrêté si
 * l'utilisateur préfère réduire les animations.
 *
 * `inset` (facultatif) : marges transparentes du fichier logo à retirer, en fractions
 * de l'image [haut, droite, bas, gauche] — permet d'utiliser le logo officiel tel quel.
 * `ratio` : largeur / hauteur de la partie visible du logo.
 */
export type Partner = { name: string; href: string; logo: string; inset?: number[]; ratio?: number };
interface Props { partners: Partner[]; label: string; }
const { partners, label } = Astro.props;
const list = (partners ?? []).filter((p) => p && p.name && p.href && p.logo);

// assez d'éléments pour remplir la largeur, puis la séquence est doublée pour une boucle sans couture
const reps = list.length ? Math.max(1, Math.ceil(8 / list.length)) : 0;
const sequence = Array.from({ length: reps }, () => list).flat();
const duration = Math.max(24, sequence.length * 4.5);
// tous les logos ont la même largeur : la hauteur de la zone logo s'adapte au plus haut d'entre eux
const ratioOf = (p: Partner) => (Number(p.ratio) > 0 ? Number(p.ratio) : 2);
const minRatio = list.length ? Math.min(...list.map(ratioOf)) : 2;

function frame(p: Partner) {
  const [t = 0, r = 0, b = 0, l = 0] = (p.inset ?? []).map(Number);
  const fw = 1 - l - r;
  const fh = 1 - t - b;
  if (!(fw > 0 && fh > 0) || (t === 0 && r === 0 && b === 0 && l === 0)) return null;
  return {
    box: `aspect-ratio:${ratioOf(p)}`,
    img: `width:${(100 / fw).toFixed(3)}%;height:${(100 / fh).toFixed(3)}%;left:${((-l / fw) * 100).toFixed(3)}%;top:${((-t / fh) * 100).toFixed(3)}%`,
  };
}
const safeHref = (h: string) => (/^https?:\/\//i.test(h) ? h : '#');
---
{list.length > 0 && (
  <div class="pm" style={`--pm-dur:${duration}s;--pm-ratio:${minRatio}`} aria-label={label} role="region">
    <ul class="pm-track">
      {[0, 1].map((copy) =>
        sequence.map((p, i) => {
          const f = frame(p);
          const primary = copy === 0 && i < list.length;
          return (
            <li class="pm-item" aria-hidden={primary ? undefined : 'true'}>
              <a
                class="pm-card"
                href={safeHref(p.href)}
                target="_blank"
                rel="noopener"
                tabindex={primary ? undefined : -1}
                data-track={`Partenaire → ${p.name}`}
                title={p.name}
              >
                <span class={`pm-logo ${f ? 'crop' : ''}`} style={f?.box}>
                  <img src={p.logo} alt={primary ? p.name : ''} loading="lazy" decoding="async" style={f?.img} referrerpolicy="no-referrer" />
                </span>
                <span class="pm-name">{p.name}<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" /></svg></span>
              </a>
            </li>
          );
        }),
      )}
    </ul>
  </div>
)}

<style>
  .pm {
    position: relative;
    overflow: hidden;
    padding: 1.6rem 0 2.2rem;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 9%, #000 91%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 9%, #000 91%, transparent);
  }
  .pm::before {
    /* fil doré sur lequel « glissent » les logos */
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 210, 48, 0.45), transparent);
    transform: translateY(-0.9rem);
  }
  .pm-track {
    display: flex;
    width: max-content;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    animation: pm-scroll var(--pm-dur, 30s) linear infinite;
  }
  .pm:hover .pm-track,
  .pm:focus-within .pm-track {
    animation-play-state: paused;
  }
  @keyframes pm-scroll {
    from {
      transform: translateX(calc(-50% - 0.75rem));
    }
    to {
      transform: translateX(0);
    }
  }
  .pm-item {
    flex: none;
    display: flex;
    animation: pm-float 6s ease-in-out infinite;
  }
  .pm-item:nth-child(2n) {
    animation-delay: -3s;
  }
  @keyframes pm-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
  }
  .pm-card {
    position: relative;
    --pm-w: 10.5rem;
    display: grid;
    grid-template-rows: calc(var(--pm-w) / var(--pm-ratio, 2)) auto;
    justify-items: center;
    align-items: center;
    gap: 0.7rem;
    width: 15rem;
    padding: 1.2rem 1.4rem 0.9rem;
    border-radius: 1.1rem;
    background: linear-gradient(160deg, #fffdf7, #efe9dc);
    border: 1px solid rgba(255, 210, 48, 0.25);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
    overflow: hidden;
    transition:
      transform 0.45s cubic-bezier(0.22, 0.61, 0.36, 1),
      box-shadow 0.45s ease,
      border-color 0.45s ease;
  }
  .pm-card::after {
    /* reflet lumineux qui traverse la carte au survol */
    content: '';
    position: absolute;
    inset: -40% auto -40% -60%;
    width: 45%;
    background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.85), transparent);
    transform: skewX(-18deg) translateX(-120%);
    transition: transform 0.9s ease;
    pointer-events: none;
  }
  .pm-card:hover,
  .pm-card:focus-visible {
    transform: translateY(-6px) scale(1.04);
    border-color: rgba(255, 210, 48, 0.9);
    box-shadow:
      0 18px 40px rgba(0, 0, 0, 0.45),
      0 0 0 4px rgba(255, 210, 48, 0.15),
      0 0 38px rgba(255, 210, 48, 0.28);
    outline: none;
  }
  .pm-card:hover::after,
  .pm-card:focus-visible::after {
    transform: skewX(-18deg) translateX(520%);
  }
  .pm-logo {
    position: relative;
    display: block;
    width: var(--pm-w);
    align-self: center;
  }
  .pm-logo img {
    display: block;
    width: 100%;
    height: auto;
    filter: saturate(0.92);
    transition: filter 0.4s ease;
  }
  .pm-logo.crop {
    overflow: hidden;
  }
  .pm-logo.crop img {
    position: absolute;
    max-width: none;
  }
  .pm-card:hover .pm-logo img {
    filter: saturate(1.1);
  }
  .pm-name {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    max-width: 100%;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
    color: #6b5a2e;
    opacity: 0.75;
    transition: opacity 0.3s ease, color 0.3s ease;
  }
  .pm-card:hover .pm-name {
    opacity: 1;
    color: #96721d;
  }
  @media (max-width: 640px) {
    .pm-card {
      --pm-w: 8.5rem;
      width: 12rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pm {
      -webkit-mask-image: none;
      mask-image: none;
    }
    .pm-track {
      animation: none;
      width: auto;
      flex-wrap: wrap;
      justify-content: center;
    }
    .pm-item,
    .pm-item[aria-hidden='true'] {
      animation: none;
    }
    .pm-item[aria-hidden='true'] {
      display: none;
    }
  }
</style>
