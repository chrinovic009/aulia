---
/** Visualisation abstraite d'ANIMA : des signaux entrent, le noyau coordonne, des systèmes reçoivent. */
import { ui, type Lang } from '../i18n.ts';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = ui[lang];
const inputs = t.coreInputs;
const outputs = ['CARE', 'VIGIL', 'FLOW', 'VR'];
const cy = 230;
const inY = inputs.map((_, i) => 70 + i * 80);
const outY = outputs.map((_, i) => 95 + i * 90);
---

<figure class="core-fig">
  <svg viewBox="0 0 640 460" role="img" aria-labelledby="core-t core-d">
    <title id="core-t">{t.coreTitle}</title>
    <desc id="core-d">{t.coreDesc}</desc>
    <defs>
      <radialGradient id="core-g" cx="0.5" cy="0.5" r="0.5">
        <stop offset="0" stop-color="#e4c77d" stop-opacity="0.5" />
        <stop offset="0.35" stop-color="#c6a45c" stop-opacity="0.16" />
        <stop offset="1" stop-color="#c6a45c" stop-opacity="0" />
      </radialGradient>
    </defs>

    {inputs.map((label, i) => {
      const d = `M118 ${inY[i]} C 210 ${inY[i]}, 230 ${cy}, 286 ${cy}`;
      return (
        <g>
          <path d={d} class="wire" />
          <circle r="2" class="sig"><animateMotion dur={`${3.2 + i * 0.4}s`} repeatCount="indefinite" path={d} /></circle>
          <circle cx="112" cy={inY[i]} r="3" class="in-dot" />
          <text x="98" y={inY[i] + 4} class="lbl" text-anchor="end">{label}</text>
        </g>
      );
    })}

    {outputs.map((label, i) => {
      const d = `M354 ${cy} C 410 ${cy}, 430 ${outY[i]}, 512 ${outY[i]}`;
      return (
        <g>
          <path d={d} class="wire target" />
          <circle r="2" class="sig out"><animateMotion dur={`${3.6 + i * 0.5}s`} begin={`${i * 0.6}s`} repeatCount="indefinite" path={d} /></circle>
          <rect x="512" y={outY[i] - 17} width="104" height="34" rx="17" class="sys" />
          <text x="564" y={outY[i] + 4} class="sys-t" text-anchor="middle">{label}</text>
        </g>
      );
    })}

    <circle cx="320" cy={cy} r="120" fill="url(#core-g)" />
    <circle cx="320" cy={cy} r="62" class="ring r1" />
    <circle cx="320" cy={cy} r="46" class="ring r2" />
    <circle cx="320" cy={cy} r="32" class="core" />
    <text x="320" y={cy + 4} class="core-t" text-anchor="middle">ANIMA</text>
  </svg>
  <figcaption>{t.coreCaption}</figcaption>
</figure>

<style>
  .core-fig {
    margin: 0;
  }
  svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .wire {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1;
  }
  .wire.target {
    stroke: var(--gold);
    stroke-dasharray: 3 5;
    opacity: 0.6;
  }
  .sig {
    fill: var(--ivory);
    opacity: 0.85;
  }
  .sig.out {
    fill: var(--gold-bright);
  }
  .in-dot {
    fill: var(--graphite);
    stroke: var(--muted);
  }
  .lbl {
    fill: var(--muted);
    font-family: var(--font-sans);
    font-size: 15px;
    letter-spacing: 0.04em;
  }
  .sys {
    fill: #1e2939;
    stroke: var(--line-strong);
  }
  .sys-t {
    fill: var(--ivory);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.22em;
  }
  .ring {
    fill: none;
    stroke: var(--gold);
    transform-origin: 320px 230px;
  }
  .r1 {
    stroke-dasharray: 2 7;
    opacity: 0.7;
    animation: spin 40s linear infinite;
  }
  .r2 {
    opacity: 0.35;
  }
  .core {
    fill: #0d0e11;
    stroke: var(--gold-bright);
  }
  .core-t {
    fill: var(--gold-bright);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.24em;
  }
  figcaption {
    margin-top: 1rem;
    font-size: 0.75rem;
    color: var(--faint);
    text-align: center;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sig {
      display: none;
    }
  }
</style>
