---
import Container from "./Container.astro"

---

<div class="relative py-16">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 m-auto h-max w-full opacity-40 dark:opacity-20">
    <div class="absolute left-[10%] top-12 h-56 w-56 rounded-full bg-gradient-to-br from-primary to-amber-200 blur-[106px] dark:from-amber-800"></div>
    <div class="absolute right-[10%] top-28 h-40 w-40 rounded-full bg-gradient-to-r from-amber-300 to-yellow-100 blur-[106px] dark:to-amber-700"></div>
  </div>
  <Container>
    <div class="relative">
      <div class="flex items-center justify-center -space-x-2">
        <img
          loading="lazy"
          width="400"
          height="400"
          src="./images/avatars/avatar-3.png"
          alt="member photo"
          class="h-8 w-8 rounded-full object-cover"
        />
        <img
          loading="lazy"
          width="200"
          height="200"
          src="./images/avatars/avatar-1.png"
          alt="member photo"
          class="h-12 w-12 rounded-full object-cover"
        />
        <img
          loading="lazy"
          width="200"
          height="200"
          src="./images/avatars/avatar-2.png"
          alt="member photo"
          class="z-10 h-16 w-16 rounded-full object-cover"
        />
        <img
          loading="lazy"
          width="200"
          height="200"
          src="./images/avatars/avatar-4.jpeg"
          alt="member photo"
          class="relative h-12 w-12 rounded-full object-cover"
        />
        <img
          loading="lazy"
          width="200"
          height="200"
          src="./images/avatars/avatar-5.png"
          alt="member photo"
          class="h-8 w-8 rounded-full object-cover"
        />
      </div>
      <div class="mt-6 m-auto space-y-6 md:w-8/12 lg:w-7/12">
        <h1 class="text-center text-4xl font-bold text-gray-800 dark:text-white md:text-5xl">Construisons ensemble les solutions de demain.</h1>
        <p class="text-center text-xl text-gray-600 dark:text-gray-300">
          Les grands défis exigent des idées audacieuses, une expertise solide et des collaborations visionnaires. Avec Aulia, transformons les possibilités scientifiques et technologiques en progrès concrets et durables.
        </p>
        <div class="flex flex-wrap justify-center gap-6">
          <a
              href="#"
              class="relative flex h-12 w-full items-center justify-center px-8 before:absolute before:inset-0 before:rounded-full before:bg-primary before:transition before:duration-300 hover:before:scale-105 active:duration-75 active:before:scale-95 sm:w-max"
            >
              <span class="relative text-base font-semibold text-white dark:text-dark"
                >Devenir partenaire</span
              >
            </a>
            <a
              href="#"
              class="relative flex h-12 w-full items-center justify-center px-8 before:absolute before:inset-0 before:rounded-full before:border before:border-transparent before:bg-primary/10 before:bg-gradient-to-b before:transition before:duration-300 hover:before:scale-105 active:duration-75 active:before:scale-95 dark:before:border-gray-700 dark:before:bg-gray-800 sm:w-max"
            >
              <span
                class="relative text-base font-semibold text-primary dark:text-white"
                >Découvrir nos solutions</span
              >
          </a>
        </div>
      </div>
    </div>
  </Container>
</div>