---
/** Grille de tuiles visuelles : icône + titre + ligne courte. */
import Icon from './Icon.astro';
import Status from './Status.astro';
import type { Status as S } from '../data/site.ts';
import type { Lang } from '../i18n.ts';

interface Item { icon: string; title: string; text?: string; status?: S; href?: string; }
interface Props { items: Item[]; cols?: number; lang: Lang; center?: boolean; compact?: boolean; }
const { items, cols = 4, lang, center = false, compact = false } = Astro.props;
---

<ul class:list={['tiles', { center, compact }]} style={`--cols:${cols}`}>
  {items.map((it, i) => {
    const Tag = it.href ? 'a' : 'div';
    return (
      <li class="reveal" style={`--d:${i * 60}ms`}>
        <Tag class="tile" href={it.href}>
          <span class="ico"><Icon name={it.icon} size={compact ? 22 : 26} /></span>
          {it.status && <Status status={it.status} lang={lang} />}
          <h3>{it.title}</h3>
          {it.text && <p>{it.text}</p>}
        </Tag>
      </li>
    );
  })}
</ul>

<style>
  .tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: 1.25rem;
  }
  li {
    transition-delay: var(--d);
  }
  .tile {
    height: 100%;
    display: grid;
    align-content: start;
    gap: 0.7rem;
    padding: 1.75rem 1.5rem;
    border-radius: 1.5rem;
    border: 1px solid var(--line-strong);
    background: var(--card);
    transition:
      transform 0.4s var(--ease),
      border-color 0.4s var(--ease),
      background 0.4s var(--ease);
  }
  a.tile:hover,
  div.tile:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 210, 48, 0.45);
    background: var(--card-hover);
  }
  .center .tile {
    justify-items: center;
    text-align: center;
  }
  .ico {
    width: 3.25rem;
    height: 3.25rem;
    display: grid;
    place-items: center;
    border-radius: 1rem;
    color: var(--gold-bright);
    background: linear-gradient(145deg, rgba(150, 114, 29, 0.35), rgba(150, 114, 29, 0.08));
    border: 1px solid rgba(255, 210, 48, 0.18);
    margin-bottom: 0.4rem;
  }
  .compact .tile {
    padding: 1.25rem;
    gap: 0.5rem;
  }
  .compact .ico {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.85rem;
  }
  h3 {
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.25;
  }
  .compact h3 {
    font-size: 1rem;
  }
  p {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--muted);
  }
  @media (max-width: 1080px) {
    .tiles {
      grid-template-columns: repeat(min(var(--cols), 3), minmax(0, 1fr));
    }
  }
  @media (max-width: 820px) {
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 480px) {
    .tiles {
      grid-template-columns: 1fr;
    }
    .compact.tiles,
    .center.tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
    }
    .center .tile {
      padding: 1.25rem 0.9rem;
    }
    .center p {
      font-size: 0.82rem;
    }
  }
</style>
