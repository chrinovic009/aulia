---
/**
 * AULIA — Cinematic ANIMA Awakening Intro (amorce).
 *
 * Le rendu est fait par /scripts/anima-intro.js : moteur WebGL procédural (shaders + particules GPU),
 * chargé uniquement quand l'introduction doit être jouée (une fois par session).
 * Cette amorce gère : la transition synchronisée vers le site (le symbole rejoint sa place dans
 * l'accueil), le bouton pour passer, la préférence « réduire les animations » et les cas d'échec.
 */
import { ui, type Lang } from '../i18n.ts';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = ui[lang];
---

<div id="preloader" class="preloader" role="img" aria-label={t.loading}>
  <div class="pl-bg"><canvas class="pl-canvas" aria-hidden="true"></canvas></div>
  <div class="pl-emblem" aria-hidden="true">
    <img class="pl-mark" src="/images/aulia-mark.png" alt="" width="186" height="185" />
    <img class="pl-word" src="/images/aulia-wordmark.png" alt="" width="395" height="92" />
  </div>
  <button type="button" class="pl-skip" aria-label={t.skipIntro} title={t.skipIntro}>
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 5l9 7-9 7z" /><path d="M19 5v14" /></svg>
  </button>
</div>

<script is:inline>
  (function () {
    var d = document.documentElement;
    var el = document.getElementById('preloader');
    if (!el) return;
    if (!d.classList.contains('preloading')) { el.parentNode.removeChild(el); return; }

    var done = false, started = false;
    var emblem = el.querySelector('.pl-emblem');

    function cleanup() {
      d.classList.remove('preloading', 'preloaded');
      if (el.parentNode) el.parentNode.removeChild(el);
      window.dispatchEvent(new Event('aulia:ready'));
    }

    // Le symbole rejoint l'emblème de la page d'accueil (si présent), pendant que le fond s'efface.
    function flyToHero() {
      var hero = document.querySelector('[data-emblem] svg');
      var mark = el.querySelector('.pl-mark');
      if (!hero || !mark) return false;
      var h = hero.getBoundingClientRect(), m = mark.getBoundingClientRect();
      if (!h.width || h.bottom < 0 || h.top > window.innerHeight) return false;
      var tw = h.width * (297.6 / 600);
      var tx = h.left + h.width * (151 / 600) + tw / 2;
      var ty = h.top + h.height * (151 / 680) + (h.height * (296 / 680)) / 2;
      var sc = tw / m.width;
      var dx = tx - (m.left + m.width / 2), dy = ty - (m.top + m.height / 2);
      emblem.style.transform = 'translate(-50%, calc(-50% + var(--my, 0px))) translate(' + dx + 'px,' + dy + 'px) scale(' + sc + ')';
      return true;
    }

    function finish(fast) {
      if (done) return;
      done = true;
      try { sessionStorage.setItem('aulia-intro', '1'); } catch (e) {}
      if (fast) {
        el.classList.add('out-fast');
        setTimeout(cleanup, 480);
        return;
      }
      el.classList.add('leaving');
      var flew = flyToHero();
      if (flew) d.classList.add('intro-landing'); else el.classList.add('out-soft');
      setTimeout(function () {
        el.classList.add('landed');
        d.classList.remove('intro-landing');
        setTimeout(cleanup, 260);
      }, 1250);
    }

    function fallback() {
      if (done) return;
      el.classList.add('static', 'emerge');
      setTimeout(function () { finish(false); }, 1800);
    }

    el.__aulia = {
      finish: finish,
      fallback: fallback,
      emerge: function () { el.classList.add('emerge'); },
      started: function () { started = true; },
      isDone: function () { return done; },
    };

    el.querySelector('.pl-skip').addEventListener('click', function () { finish(true); });
    window.addEventListener('keydown', function (e) { if (e.key === 'Escape') finish(true); });

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { fallback(); return; }

    var s = document.createElement('script');
    s.src = '/scripts/anima-intro.js';
    s.async = true;
    s.onerror = fallback;
    document.head.appendChild(s);
    // si le moteur ne démarre pas rapidement (réseau lent, WebGL indisponible), on passe au repli
    setTimeout(function () { if (!started) fallback(); }, 4500);
  })();
</script>

<style is:global>
  .preloader {
    display: none;
  }
  html.preloading body {
    overflow: hidden;
  }
  html.preloading .preloader {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: block;
  }
  .pl-bg {
    position: absolute;
    inset: 0;
    background: #000;
    transition: opacity 1.15s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .pl-canvas {
    position: absolute;
    inset: 0;
    display: block;
  }
  .preloader.leaving .pl-bg,
  .preloader.out-soft .pl-emblem {
    opacity: 0;
  }
  .preloader.out-fast {
    opacity: 0;
    transition: opacity 0.45s ease;
  }
  .pl-emblem {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--s, 240px);
    transform: translate(-50%, calc(-50% + var(--my, -30px)));
    transform-origin: 50% 50%;
    display: grid;
    justify-items: center;
    pointer-events: none;
    transition:
      transform 1.2s cubic-bezier(0.65, 0, 0.25, 1),
      opacity 1s ease;
  }
  .pl-mark {
    width: 100%;
    height: auto;
    opacity: 0;
    filter: blur(10px) brightness(2.4) drop-shadow(0 0 40px rgba(255, 210, 48, 0.7));
  }
  .pl-word {
    position: absolute;
    top: calc(100% + var(--s, 240px) * 0.18);
    width: 64%;
    height: auto;
    opacity: 0;
    filter: blur(6px);
    transition: opacity 0.6s ease;
  }
  .preloader.emerge .pl-mark {
    animation: pl-mark 1.6s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
  }
  .preloader.emerge .pl-word {
    animation: pl-word 1.4s cubic-bezier(0.22, 0.61, 0.36, 1) 0.6s forwards;
  }
  .preloader.static .pl-mark,
  .preloader.static .pl-word {
    animation-duration: 0.7s;
    animation-delay: 0s;
  }
  .preloader.leaving .pl-word {
    animation: none;
    opacity: 0;
  }
  /* pendant le vol du symbole, l'emblème de l'accueil attend son arrivée */
  html.intro-landing [data-emblem] svg {
    opacity: 0;
  }
  [data-emblem] svg {
    transition: opacity 0.3s ease;
  }
  .preloader.landed .pl-emblem {
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .preloader.leaving .pl-skip {
    display: none;
  }
  .pl-skip {
    position: absolute;
    right: 1.25rem;
    bottom: 1.25rem;
    width: 2.6rem;
    height: 2.6rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.03);
    color: rgba(255, 255, 255, 0.45);
    cursor: pointer;
    opacity: 0;
    animation: pl-in 0.6s ease 1.2s forwards;
    transition:
      color 0.3s ease,
      border-color 0.3s ease;
  }
  .pl-skip:hover,
  .pl-skip:focus-visible {
    color: #ffd230;
    border-color: rgba(255, 210, 48, 0.5);
  }
  @keyframes pl-mark {
    0% {
      opacity: 0;
      filter: blur(10px) brightness(2.4) drop-shadow(0 0 40px rgba(255, 210, 48, 0.7));
    }
    60% {
      opacity: 1;
    }
    100% {
      opacity: 1;
      filter: blur(0) brightness(1) drop-shadow(0 0 18px rgba(255, 210, 48, 0.35));
    }
  }
  @keyframes pl-word {
    to {
      opacity: 1;
      filter: blur(0);
    }
  }
  @keyframes pl-in {
    to {
      opacity: 1;
    }
  }
</style>
