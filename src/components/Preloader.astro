---
/**
 * AULIA — écran d'ouverture : « l'éveil de l'emblème ».
 *
 * Seul l'emblème AULIA est animé, dans l'esprit d'ANIMA (une intelligence qui s'éveille) :
 *  1. un point de lumière naît au cœur du cercle et respire ;
 *  2. une comète d'or trace le cercle, reliée au cœur par un fil de lumière ;
 *  3. une constellation de points se relie et dessine le A, qui prend corps ;
 *  4. le cœur s'élève et devient le point d'or ; la vague d'or se déploie ;
 *  5. une onde royale part du point d'or, un éclat fait le tour du cercle ;
 *  6. l'emblème respire, puis rejoint sa place dans l'accueil.
 *
 * SVG (le logo) + canvas 2D (la lumière), sans bibliothèque, ~4 s, une fois par session.
 * Passable (bouton, Échap), « réduire les animations » respecté, jamais plus de 8 s.
 */
import { uiText } from '../data/site.ts';
import { type Lang } from '../i18n.ts';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = uiText(lang, Astro.locals);
// tracés de l'emblème (repère 186 × 185, identique à l'emblème de l'accueil)
const RING = 'M110.9 176.1 A86 86 0 1 1 165.1 138.8';
const LETTER = 'M88 57 L101 57 L146 139 L135 137 L96 76 L61 141 L44 141 Z';
const WAVE = 'M76 130 C88 120 103 119 117 131 C131 144 146 158 167 165 C148 168 131 162 119 151 C106 139 93 131 76 130 Z';
---

<div id="preloader" class="preloader" role="img" aria-label={t.loading}>
  <div class="pl-bg"></div>
  <div class="pl-emblem" aria-hidden="true">
    <svg class="pl-mark" viewBox="0 0 186 185" width="186" height="185">
      <defs>
        <linearGradient id="pl-g-ring" x1="0" y1="1" x2="1" y2="0">
          <stop offset="0" class="pl-s1" />
          <stop offset="0.45" class="pl-s2" />
          <stop offset="1" class="pl-s3" />
        </linearGradient>
        <linearGradient id="pl-g-gold" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#f6df94" />
          <stop offset="0.55" stop-color="#d3a842" />
          <stop offset="1" stop-color="#8f6c27" />
        </linearGradient>
        <radialGradient id="pl-g-dot" cx="0.36" cy="0.32" r="0.72">
          <stop offset="0" stop-color="#fff3c9" />
          <stop offset="0.55" stop-color="#d8ae4a" />
          <stop offset="1" stop-color="#7e5d1e" />
        </radialGradient>
        <clipPath id="pl-w-clip"><rect id="pl-w-wipe" x="-22" y="110" width="96" height="62" /></clipPath>
        <filter id="pl-blur" x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="2.6" /></filter>
      </defs>
      <path id="pl-ring-glow" d={RING} fill="none" stroke="#f4d77d" stroke-width="6" stroke-linecap="round" pathLength="1" filter="url(#pl-blur)" />
      <path id="pl-ring" d={RING} fill="none" stroke="url(#pl-g-ring)" stroke-width="2.8" stroke-linecap="round" pathLength="1" />
      <path id="pl-shine" d={RING} fill="none" stroke="#fff6d2" stroke-width="3.4" stroke-linecap="round" pathLength="1" />
      <path id="pl-letter" d={LETTER} />
      <g clip-path="url(#pl-w-clip)"><path id="pl-wave" d={WAVE} fill="url(#pl-g-gold)" /></g>
      <circle id="pl-dot" cx="98" cy="40" r="9.5" fill="url(#pl-g-dot)" />
    </svg>
  </div>
  <canvas class="pl-light" aria-hidden="true"></canvas>
  <button type="button" class="pl-skip" aria-label={t.skipIntro} title={t.skipIntro}>
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 5l9 7-9 7z" /><path d="M19 5v14" /></svg>
  </button>
</div>

<script is:inline>
  (function () {
    var d = document.documentElement;
    var el = document.getElementById('preloader');
    if (!el) return;
    if (!d.classList.contains('preloading')) { el.parentNode.removeChild(el); return; }

    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // thème clair : lumière dorée dessinée « en encre » plutôt qu'en addition de lumière
    var LIGHT = d.getAttribute('data-theme') === 'light';
    var LINE = LIGHT ? 'rgba(168,124,30,1)' : 'rgba(255,218,140,1)';
    var DURATION = reduced ? 700 : 4300;
    var done = false;
    var emblem = el.querySelector('.pl-emblem');
    var $ = function (id) { return document.getElementById(id); };
    var ring = $('pl-ring'), ringGlow = $('pl-ring-glow'), shine = $('pl-shine');
    var letter = $('pl-letter'), wipe = $('pl-w-wipe'), dot = $('pl-dot');

    // ─────────────── outils ───────────────
    var clamp = function (v, a, b) { return v < a ? a : v > b ? b : v; };
    var seg = function (t, a, b) { return clamp((t - a) / (b - a), 0, 1); };
    var easeIO = function (x) { return x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2; };
    var easeOut = function (x) { return 1 - Math.pow(1 - x, 3); };
    var backOut = function (x) { var c = 1.7; return 1 + (c + 1) * Math.pow(x - 1, 3) + c * Math.pow(x - 1, 2); };
    var rand = function (a, b) { return a + Math.random() * (b - a); };

    // géométrie de l'emblème (repère 186 × 185)
    var L = ring.getTotalLength ? ring.getTotalLength() : 0;
    var ringAt = function (f) { var p = ring.getPointAtLength(clamp(f, 0, 1) * L); return { x: p.x, y: p.y }; };
    var C = (function () {
      // centre du cercle à partir de trois points du tracé
      var a = ringAt(0), b = ringAt(0.5), c = ringAt(1);
      var D = 2 * (a.x * (b.y - c.y) + b.x * (c.y - a.y) + c.x * (a.y - b.y));
      var ux = ((a.x * a.x + a.y * a.y) * (b.y - c.y) + (b.x * b.x + b.y * b.y) * (c.y - a.y) + (c.x * c.x + c.y * c.y) * (a.y - b.y)) / D;
      var uy = ((a.x * a.x + a.y * a.y) * (c.x - b.x) + (b.x * b.x + b.y * b.y) * (a.x - c.x) + (c.x * c.x + c.y * c.y) * (b.x - a.x)) / D;
      return { x: ux, y: uy };
    })();
    var DOT = { x: 98, y: 40 };
    // constellation du A : sommets et points intermédiaires du tracé
    var A_PTS = [[44, 141], [52, 126], [61, 110], [70, 93], [79, 76], [88, 57], [101, 57], [112, 77], [123, 97], [134, 117], [146, 139], [135, 137], [116, 106], [96, 76], [78, 109], [61, 141]];
    var A_LINKS = [];
    for (var i = 0; i < A_PTS.length; i++) A_LINKS.push([i, (i + 1) % A_PTS.length]);
    A_LINKS.push([3, 13], [8, 13], [2, 14], [12, 9]);

    // ─────────────── canvas de lumière ───────────────
    var cv = el.querySelector('.pl-light');
    var ctx = cv.getContext('2d');
    var dpr = Math.min(window.devicePixelRatio || 1, 2);
    var box = { x: 0, y: 0, s: 1 };
    var markEl = el.querySelector('.pl-mark');
    function measure() {
      var r = markEl.getBoundingClientRect();
      if (r.width) box = { x: r.left, y: r.top, s: r.width / 186 };
    }
    function layout() {
      cv.width = Math.round(innerWidth * dpr);
      cv.height = Math.round(innerHeight * dpr);
      measure();
    }
    // logo → écran (pixels du canvas)
    var X = function (x) { return (box.x + x * box.s) * dpr; };
    var Y = function (y) { return (box.y + y * box.s) * dpr; };
    var S = function (v) { return v * box.s * dpr; };

    // halo pré-calculé (rapide à dessiner, beaucoup d'éclats)
    var sprite = document.createElement('canvas');
    sprite.width = sprite.height = 64;
    (function () {
      var g = sprite.getContext('2d');
      var gr = g.createRadialGradient(32, 32, 0, 32, 32, 32);
      if (LIGHT) {
        gr.addColorStop(0, 'rgba(255,236,170,1)');
        gr.addColorStop(0.2, 'rgba(214,160,40,0.85)');
        gr.addColorStop(0.55, 'rgba(190,140,30,0.2)');
        gr.addColorStop(1, 'rgba(190,140,30,0)');
      } else {
        gr.addColorStop(0, 'rgba(255,246,214,1)');
        gr.addColorStop(0.25, 'rgba(255,214,120,0.7)');
        gr.addColorStop(0.6, 'rgba(214,160,60,0.18)');
        gr.addColorStop(1, 'rgba(214,160,60,0)');
      }
      g.fillStyle = gr;
      g.fillRect(0, 0, 64, 64);
    })();
    function glow(x, y, r, a) {
      if (a <= 0.003 || r <= 0) return;
      ctx.globalAlpha = Math.min(1, a);
      ctx.drawImage(sprite, X(x) - S(r), Y(y) - S(r), S(r) * 2, S(r) * 2);
    }

    var fired = {};
    var once = function (k, cond) { if (cond && !fired[k]) { fired[k] = 1; return true; } return false; };
    var sparks = [];
    function emit(x, y, n, speed, life, size) {
      for (var k = 0; k < n; k++) {
        var a = Math.random() * Math.PI * 2, v = rand(0.2, 1) * speed;
        sparks.push({ x: x, y: y, vx: Math.cos(a) * v, vy: Math.sin(a) * v - 0.04, life: 0, max: rand(0.6, 1) * life, size: rand(0.6, 1.2) * size });
      }
    }
    // poussière d'or ambiante
    var motes = [];
    for (var m = 0; m < 46; m++) motes.push({ a: Math.random() * Math.PI * 2, r: rand(40, 150), w: rand(-0.08, 0.08), y: rand(-0.02, 0.02), s: rand(0.5, 1.4), p: Math.random() });

    // ─────────────── état du logo (SVG) ───────────────
    function setLogo(t) {
      var pr = easeIO(seg(t, 700, 1950));
      ring.style.strokeDashoffset = String(1 - pr);
      ring.style.opacity = pr > 0 ? '1' : '0';
      ringGlow.style.strokeDashoffset = String(1 - pr);
      ringGlow.style.opacity = String(pr > 0 ? 0.6 * (1 - seg(t, 2000, 2800)) + 0.25 * seg(t, 3150, 3400) * (1 - seg(t, 3500, 4200)) : 0);
      var fa = easeOut(seg(t, 2150, 2650));
      letter.style.opacity = String(fa);
      letter.style.transform = 'scale(' + (0.94 + 0.06 * fa) + ')';
      var w = easeOut(seg(t, 2700, 3300));
      wipe.setAttribute('x', String(-22 + 96 * w));
      var land = seg(t, 2950, 3150);
      dot.style.opacity = land > 0 ? '1' : '0';
      dot.style.transform = 'scale(' + (land > 0 ? 0.7 + 0.3 * backOut(land) : 0.7) + ')';
      var sh = seg(t, 3150, 4000);
      shine.style.opacity = String(sh > 0 && sh < 1 ? Math.sin(sh * Math.PI) : 0);
      shine.style.strokeDashoffset = String(0.1 - 1.1 * easeIO(sh));
      var br = seg(t, 3150, 3500) * (1 - 0.6 * seg(t, 3500, 4300));
      emblem.style.filter = br > 0 ? 'drop-shadow(0 0 ' + (4 + 16 * br).toFixed(1) + 'px rgba(236,200,101,' + (0.12 + 0.4 * br).toFixed(2) + '))' : '';
    }

    // ─────────────── lumière (canvas) ───────────────
    var last = 0;
    function draw(t) {
      var dt = Math.min(0.05, (t - last) / 1000) || 0.016;
      last = t;
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.clearRect(0, 0, cv.width, cv.height);
      ctx.globalCompositeOperation = LIGHT ? 'source-over' : 'lighter';

      // poussière d'or
      var ma = 0.5 * seg(t, 0, 900) * (1 - 0.5 * seg(t, 3600, 4300));
      for (var i = 0; i < motes.length; i++) {
        var o = motes[i];
        o.a += o.w * dt;
        var tw = 0.5 + 0.5 * Math.sin(t / 600 + o.p * 6.28);
        glow(C.x + Math.cos(o.a) * o.r, C.y + Math.sin(o.a) * o.r * 0.92 + Math.sin(t / 1400 + o.p * 9) * 3, 1.6 * o.s, ma * tw * 0.5);
      }

      // le cœur : naît au centre, respire, puis s'élève jusqu'au point d'or
      var born = easeOut(seg(t, 80, 700));
      var rise = easeIO(seg(t, 2400, 2980));
      var cx = C.x + (DOT.x - C.x) * rise, cy = C.y + (DOT.y - C.y) * rise;
      var breathe = 1 + 0.12 * Math.sin(t / 210);
      if (t < 3150) {
        var fade = 1 - seg(t, 2980, 3150);
        glow(cx, cy, 26 * born * breathe, 0.55 * born * fade);
        glow(cx, cy, 7 * born, 1 * born * fade);
        if (rise > 0 && rise < 1) emit(cx, cy, 2, 9, 0.7, 1.4);
      }

      // la comète trace le cercle, reliée au cœur par un fil de lumière
      var pr = easeIO(seg(t, 700, 1950));
      if (pr > 0 && pr < 1) {
        var h = ringAt(pr);
        glow(h.x, h.y, 13, 0.9);
        glow(h.x, h.y, 4, 1);
        emit(h.x, h.y, 3, 7, 0.9, 1.5);
        ctx.globalAlpha = 0.28 * (1 - Math.abs(pr - 0.5) * 1.2);
        ctx.strokeStyle = LINE;
        ctx.lineWidth = S(0.5);
        ctx.beginPath();
        ctx.moveTo(X(C.x), Y(C.y));
        ctx.lineTo(X(h.x), Y(h.y));
        ctx.stroke();
      }
      if (once('ring', t >= 1950)) emit(ringAt(1).x, ringAt(1).y, 14, 14, 0.9, 1.6);

      // la constellation dessine le A
      var nodes = seg(t, 1650, 2150), linkP = seg(t, 1850, 2350), out = seg(t, 2350, 2800);
      if (nodes > 0 && out < 1) {
        var n = A_PTS.length;
        // fils depuis le cœur
        ctx.strokeStyle = LINE;
        ctx.lineWidth = S(0.45);
        for (var k = 0; k < n; k++) {
          var ap = seg(nodes, k / n * 0.7, k / n * 0.7 + 0.3);
          if (ap <= 0) continue;
          var p = A_PTS[k];
          ctx.globalAlpha = 0.18 * ap * (1 - linkP);
          ctx.beginPath();
          ctx.moveTo(X(C.x), Y(C.y));
          ctx.lineTo(X(C.x + (p[0] - C.x) * ap), Y(C.y + (p[1] - C.y) * ap));
          ctx.stroke();
          glow(p[0], p[1], 5 * ap, 0.8 * ap * (1 - out));
        }
        // liens du réseau
        ctx.lineWidth = S(0.7);
        for (var q = 0; q < A_LINKS.length; q++) {
          var lp = seg(linkP, q / A_LINKS.length * 0.6, q / A_LINKS.length * 0.6 + 0.4);
          if (lp <= 0) continue;
          var a1 = A_PTS[A_LINKS[q][0]], a2 = A_PTS[A_LINKS[q][1]];
          ctx.globalAlpha = 0.55 * (1 - out);
          ctx.beginPath();
          ctx.moveTo(X(a1[0]), Y(a1[1]));
          ctx.lineTo(X(a1[0] + (a2[0] - a1[0]) * lp), Y(a1[1] + (a2[1] - a1[1]) * lp));
          ctx.stroke();
        }
      }
      if (once('a', t >= 2350)) for (var z = 0; z < A_PTS.length; z++) emit(A_PTS[z][0], A_PTS[z][1], 3, 10, 0.8, 1.2);

      // la vague d'or : éclats à sa tête
      var w = easeOut(seg(t, 2700, 3300));
      if (w > 0 && w < 0.98) {
        var wx = 76 + 91 * w, wy = 130 + 35 * Math.pow(w, 1.3) - 8 * Math.sin(w * Math.PI);
        glow(wx, wy, 9, 0.7);
        emit(wx, wy, 2, 6, 0.6, 1.2);
      }

      // l'onde royale depuis le point d'or
      var sw = seg(t, 3150, 4000);
      if (sw > 0 && sw < 1) {
        var rr = 10 + 150 * easeOut(sw);
        ctx.globalAlpha = 0.5 * (1 - sw);
        ctx.strokeStyle = LINE;
        ctx.lineWidth = S(1.4 * (1 - sw) + 0.3);
        ctx.beginPath();
        ctx.arc(X(DOT.x), Y(DOT.y), S(rr), 0, Math.PI * 2);
        ctx.stroke();
        // rayons
        var ra = 0.35 * Math.sin(sw * Math.PI);
        for (var rj = 0; rj < 12; rj++) {
          var ang = rj / 12 * Math.PI * 2 + 0.26;
          ctx.globalAlpha = ra * (rj % 2 ? 0.5 : 1);
          ctx.lineWidth = S(0.6);
          ctx.beginPath();
          ctx.moveTo(X(DOT.x + Math.cos(ang) * 14), Y(DOT.y + Math.sin(ang) * 14));
          ctx.lineTo(X(DOT.x + Math.cos(ang) * (14 + 40 * easeOut(sw))), Y(DOT.y + Math.sin(ang) * (14 + 40 * easeOut(sw))));
          ctx.stroke();
        }
        glow(DOT.x, DOT.y, 30, 0.6 * (1 - sw));
      }
      if (once('dot', t >= 3150)) emit(DOT.x, DOT.y, 26, 22, 1.1, 1.6);
      // le point d'or respire
      if (t >= 3150) glow(DOT.x, DOT.y, 16 * (1 + 0.1 * Math.sin(t / 260)), 0.32);

      // éclats
      for (var s = sparks.length - 1; s >= 0; s--) {
        var sp = sparks[s];
        sp.life += dt;
        if (sp.life >= sp.max) { sparks.splice(s, 1); continue; }
        sp.x += sp.vx * dt;
        sp.y += sp.vy * dt;
        sp.vx *= 0.96;
        sp.vy = sp.vy * 0.96 + 2 * dt;
        var lf = 1 - sp.life / sp.max;
        glow(sp.x, sp.y, sp.size * (0.6 + lf), lf * 0.9);
      }
      ctx.globalAlpha = 1;
    }

    // ─────────────── boucle ───────────────
    var t0 = 0, raf = 0, running = false;
    function frame(now) {
      if (!t0) t0 = now;
      var t = now - t0;
      measure();
      setLogo(t);
      draw(t);
      if (running) raf = requestAnimationFrame(frame);
    }
    function stopLight() {
      running = false;
      cancelAnimationFrame(raf);
      cv.classList.add('off');
    }
    function finalState() {
      setLogo(99999);
      emblem.style.filter = 'drop-shadow(0 0 6px rgba(236,200,101,0.2))';
    }

    // ─────────────── sortie : l'emblème rejoint l'accueil ───────────────
    function cleanup() {
      stopLight();
      d.classList.remove('preloading', 'preloaded');
      if (el.parentNode) el.parentNode.removeChild(el);
      window.dispatchEvent(new Event('aulia:ready'));
    }
    function flyToHero() {
      var hero = document.querySelector('[data-emblem] svg');
      var mark = el.querySelector('.pl-mark');
      if (!hero || !mark) return false;
      var h = hero.getBoundingClientRect(), mk = mark.getBoundingClientRect();
      if (!h.width || h.bottom < 0 || h.top > window.innerHeight) return false;
      var tw = h.width * (297.6 / 600);
      var tx = h.left + h.width * (151 / 600) + tw / 2;
      var ty = h.top + h.height * (151 / 680) + (h.height * (296 / 680)) / 2;
      var sc = tw / mk.width;
      var dx = tx - (mk.left + mk.width / 2), dy = ty - (mk.top + mk.height / 2);
      emblem.style.transform = 'translate(-50%, -50%) translate(' + dx + 'px,' + dy + 'px) scale(' + sc + ')';
      return true;
    }
    function finish(fast) {
      if (done) return;
      done = true;
      try { localStorage.setItem('aulia-intro', '1'); } catch (e) {}
      if (fast) {
        stopLight();
        el.classList.add('out-fast');
        setTimeout(cleanup, 480);
        return;
      }
      finalState();
      el.classList.add('leaving');
      setTimeout(stopLight, 900);
      var flew = !reduced && flyToHero();
      if (flew) d.classList.add('intro-landing'); else el.classList.add('out-soft');
      setTimeout(function () {
        el.classList.add('landed');
        d.classList.remove('intro-landing');
        setTimeout(cleanup, 260);
      }, flew ? 1150 : 700);
    }

    el.querySelector('.pl-skip').addEventListener('click', function () { finish(true); });
    window.addEventListener('keydown', function (e) {
      if (['Escape', ' ', 'Enter', 'ArrowDown', 'PageDown', 'End'].indexOf(e.key) >= 0) finish(true);
    });
    // le visiteur touche l'écran, fait défiler ou clique : l'introduction s'efface aussitôt
    ['wheel', 'touchstart', 'pointerdown'].forEach(function (ev) {
      window.addEventListener(ev, function (e) {
        if (e.target && e.target.closest && e.target.closest('.pl-skip')) return;
        finish(true);
      }, { passive: true });
    });

    if (reduced || !L || !ctx) {
      finalState();
    } else {
      setLogo(0);
      layout();
      window.addEventListener('resize', layout);
      running = true;
      raf = requestAnimationFrame(frame);
    }

    var loaded = document.readyState === 'complete';
    var timeUp = false;
    function maybeFinish() { if (loaded && timeUp) finish(false); }
    window.addEventListener('load', function () { loaded = true; maybeFinish(); });
    setTimeout(function () { timeUp = true; maybeFinish(); }, DURATION);
    setTimeout(function () { finish(false); }, 8000);
  })();
</script>

<style is:global>
  .preloader {
    display: none;
  }
  html.preloading body {
    overflow: hidden;
  }
  html.preloading .preloader {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: block;
  }
  .pl-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 50% 47%, rgba(236, 200, 101, 0.09), transparent 40%),
      radial-gradient(ellipse at 50% 120%, rgba(150, 114, 29, 0.12), transparent 60%),
      #0a0907;
    transition: opacity 1.1s cubic-bezier(0.4, 0, 0.2, 1);
  }
  html[data-theme='light'] .pl-bg {
    background:
      radial-gradient(circle at 50% 47%, rgba(214, 170, 70, 0.16), transparent 42%),
      radial-gradient(ellipse at 50% 120%, rgba(150, 114, 29, 0.1), transparent 60%),
      #faf7f0;
  }
  .pl-s1 {
    stop-color: #f3f1eb;
  }
  .pl-s2 {
    stop-color: #dcc690;
  }
  .pl-s3 {
    stop-color: #ecc865;
  }
  #pl-letter {
    fill: #f3f1eb;
  }
  html[data-theme='light'] .pl-s1 {
    stop-color: #1d1c19;
  }
  html[data-theme='light'] .pl-s2 {
    stop-color: #7a6a45;
  }
