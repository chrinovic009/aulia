---
/**
 * Section « L'équipe » — contenu géré dans l'espace d'administration (bloc « team »).
 * Un seul modèle de carte, identique pour tous (fondateur compris) : photo, nom, rôle,
 * courte description, réseaux. L'ordre est celui de la liste dans l'administration.
 */
import page from '../data/pages/team.ts';
import { block } from '../data/site.ts';
import SectionHead from './SectionHead.astro';
import Arrow from './Arrow.astro';
import { path, type Lang } from '../i18n.ts';

interface Props { lang: Lang; mode?: 'home' | 'about'; }
const { lang, mode = 'home' } = Astro.props;
const T = block(Astro.locals, 'team', lang, page);

type Member = { name: string; role?: string; expertise?: string; bio?: string; photo?: string; github?: string; linkedin?: string; instagram?: string; whatsapp?: string; email?: string };
const members = ((T.members ?? []) as Member[]).filter((m) => m && m.name?.trim());

const clean = (v?: string) => (v ?? '').trim();
const url = (base: string, v: string) => (/^https?:\/\//i.test(v) ? v : base + v.replace(/^@/, ''));
function links(m: Member) {
  const gh = clean(m.github), li = clean(m.linkedin), ig = clean(m.instagram), wa = clean(m.whatsapp), em = clean(m.email);
  const out: { key: string; label: string; href: string }[] = [];
  // LinkedIn reste visible même vide (grisé, « bientôt ») : le lien s'ajoute plus tard dans l'administration
  out.push({ key: 'linkedin', label: 'LinkedIn', href: li ? url('https://www.linkedin.com/in/', li) : '' });
  if (gh) out.push({ key: 'github', label: 'GitHub', href: url('https://github.com/', gh) });
  if (ig) out.push({ key: 'instagram', label: 'Instagram', href: url('https://www.instagram.com/', ig) });
  if (wa) out.push({ key: 'whatsapp', label: 'WhatsApp', href: /^https?:/i.test(wa) ? wa : `https://wa.me/${wa.replace(/\D/g, '')}` });
  if (em) out.push({ key: 'email', label: 'E-mail', href: `mailto:${em}` });
  return out;
}
const ICONS: Record<string, string> = {
  github: '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>',
  linkedin: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>',
  instagram: '<rect width="20" height="20" x="2" y="2" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><path d="M17.5 6.5h.01"/>',
  whatsapp: '<path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"/><path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1"/>',
  email: '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
};
const initials = (n: string) => n.split(/\s+/).slice(0, 2).map((w) => w[0]).join('').toUpperCase();
---
{members.length > 0 && (
  <section class="section team" id={mode === 'home' ? 'equipe' : 'equipe-about'}>
    <div class="tm-aura" aria-hidden="true"></div>
    <div class="wrap">
      <SectionHead eyebrow={T.eyebrow} title={T.title} lead={T.lead} center />

      <ul class="tm-grid" data-tm>
        {members.map((m, i) => (
          <li class="tm-card reveal" style={`--d:${i * 120}ms`}>
            <article class="tm-inner">
              <div class="tm-media">
                {clean(m.photo)
                  ? <img src={m.photo} alt={m.name} width="640" height="800" loading="lazy" decoding="async" />
                  : <span class="tm-initials" aria-hidden="true">{initials(m.name)}</span>}
                <span class="tm-idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="tm-seal" aria-hidden="true">
                  <img class="theme-dark-only" src="/images/aulia-mark.png" alt="" />
                  <img class="theme-light-only" src="/images/aulia-mark-light.png" alt="" />
                </span>
                <div class="tm-cap">
                  <h3>{m.name}</h3>
                  {clean(m.role) && <p class="tm-role">{m.role}</p>}
                </div>
              </div>
              <div class="tm-body">
                {clean(m.expertise) && <p class="tm-exp">{m.expertise}</p>}
                {clean(m.bio) && <p class="tm-bio">{m.bio}</p>}
                <ul class="tm-soc" aria-label={`${T.contactLabel} ${m.name}`}>
                  {links(m).map((l, k) => (
                    <li style={`--k:${k}`}>
                      {l.href ? (
                        <a href={l.href} target={l.key === 'email' ? undefined : '_blank'} rel="noopener" aria-label={`${l.label} — ${m.name}`} data-track={`Équipe : ${l.label}`}>
                          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[l.key]} />
                          <span class="tip">{l.label}</span>
                        </a>
                      ) : (
                        <span class="off" role="img" aria-label={`${l.label} — ${T.soonLabel}`}>
                          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[l.key]} />
                          <span class="tip">{l.label} · {T.soonLabel}</span>
                        </span>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          </li>
        ))}
      </ul>

      {mode === 'home' && (
        <p class="tm-more reveal"><a class="link-arrow" href={path(lang, 'about')}>{T.aboutLink}<Arrow /></a></p>
      )}
    </div>
  </section>
)}

<script>
  // Inclinaison douce de la carte sous le pointeur (souris uniquement, mouvements réduits respectés)
  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (fine) {
    document.querySelectorAll<HTMLElement>('[data-tm] .tm-card').forEach((card) => {
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        card.style.setProperty('--rx', `${(-y * 7).toFixed(2)}deg`);
        card.style.setProperty('--ry', `${(x * 9).toFixed(2)}deg`);
        card.style.setProperty('--mx', `${((x + 0.5) * 100).toFixed(1)}%`);
        card.style.setProperty('--my', `${((y + 0.5) * 100).toFixed(1)}%`);
      });
      card.addEventListener('pointerleave', () => {
        card.style.setProperty('--rx', '0deg');
        card.style.setProperty('--ry', '0deg');
      });
    });
  }
</script>

<style>
  @property --tm-a {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }
  .team {
    position: relative;
    overflow: hidden;
  }
  .tm-aura {
    position: absolute;
    left: 50%;
    top: 55%;
    width: min(70rem, 120vw);
    height: 40rem;
    translate: -50% -50%;
    background: radial-gradient(ellipse at center, rgba(150, 114, 29, 0.16), transparent 65%);
    pointer-events: none;
    animation: tm-breathe 8s ease-in-out infinite;
  }

  .tm-grid {
    list-style: none;
    margin: clamp(2.5rem, 5vw, 3.75rem) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(1.25rem, 2.5vw, 2rem);
    perspective: 1200px;
  }

  /* ── carte : identique pour tous ── */
  .tm-card {
    --rx: 0deg;
    --ry: 0deg;
    --mx: 50%;
    --my: 30%;
    position: relative;
    flex: 0 1 19rem;
    display: flex;
    border-radius: 1.6rem;
    padding: 1.5px;
    transition-delay: var(--d);
  }
  /* cadre doré animé */
  .tm-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: conic-gradient(from var(--tm-a), rgba(150, 114, 29, 0.18), #ffd230 12%, rgba(150, 114, 29, 0.18) 28%, rgba(150, 114, 29, 0.18) 62%, #c99a2e 74%, rgba(150, 114, 29, 0.18) 90%);
    animation: tm-spin 10s linear infinite;
    opacity: 0.55;
    transition: opacity 0.5s var(--ease);
  }
  .tm-card:nth-child(2n)::before {
    animation-delay: -5s;
  }
  .tm-card:hover::before {
    opacity: 1;
  }
  .tm-inner {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: calc(1.6rem - 1.5px);
    background: var(--card);
    transform: rotateX(var(--rx)) rotateY(var(--ry));
    transform-style: preserve-3d;
    transition:
      transform 0.5s var(--ease),
      box-shadow 0.5s var(--ease);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.18);
  }
  .tm-card:hover .tm-inner {
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.28);
  }
  /* reflet qui suit le pointeur */
  .tm-inner::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at var(--mx) var(--my), rgba(255, 224, 140, 0.16), transparent 45%);
    opacity: 0;
    transition: opacity 0.4s;
    pointer-events: none;
  }
  .tm-card:hover .tm-inner::after {
    opacity: 1;
  }

  /* photo */
  .tm-media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: linear-gradient(160deg, rgba(150, 114, 29, 0.35), rgba(17, 16, 13, 0.85));
  }
  .tm-media > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1.12);
    filter: saturate(0.85) brightness(0.92);
    transition:
      transform 1.6s var(--ease),
      filter 1s var(--ease);
  }
  .reveal.is-visible .tm-media > img {
    transform: scale(1);
  }
  .tm-card:hover .tm-media > img {
    transform: scale(1.05);
    filter: saturate(1.05) brightness(1);
  }
  .tm-media::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, transparent 45%, rgba(12, 11, 9, 0.88));
    pointer-events: none;
  }
  .tm-media::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(115deg, transparent 35%, rgba(255, 236, 170, 0.32) 50%, transparent 65%);
    transform: translateX(-130%);
    pointer-events: none;
  }
  .reveal.is-visible .tm-media::after {
    animation: tm-shine 1.8s calc(var(--d) + 0.5s) var(--ease) both;
  }
  .tm-card:hover .tm-media::after {
    animation: tm-shine 1.2s var(--ease) both;
  }
  .tm-initials {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: 4rem;
    font-weight: 700;
    color: #ffd230;
    letter-spacing: 0.04em;
  }
  .tm-idx {
    position: absolute;
    top: 0.95rem;
    left: 0.9rem;
    z-index: 3;
    padding: 0.3rem 0.6rem 0.3rem 0.75rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: #ffd230;
    background: rgba(17, 16, 13, 0.6);
    border: 1px solid rgba(255, 210, 48, 0.35);
    backdrop-filter: blur(6px);
  }
  .tm-seal {
    position: absolute;
    top: 0.8rem;
    right: 0.8rem;
    z-index: 3;
    width: 2.3rem;
    height: 2.3rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgba(17, 16, 13, 0.6);
    border: 1px solid rgba(255, 210, 48, 0.45);
    backdrop-filter: blur(6px);
  }
  .tm-seal img {
    width: 62%;
    height: auto;
  }
  :global(html[data-theme='light']) .tm-seal {
    background: rgba(255, 255, 255, 0.75);
  }
  .tm-cap {
    position: absolute;
    left: 1.25rem;
    right: 1.25rem;
    bottom: 1.1rem;
    z-index: 3;
    transform: translateZ(30px);
  }
  .tm-cap h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.2;
    color: #fff;
  }
  .tm-role {
    margin-top: 0.35rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #ffd230;
  }

  /* texte et réseaux */
  .tm-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1.15rem 1.25rem 1.3rem;
  }
  .tm-exp {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text);
  }
  .tm-bio {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--muted);
  }
  .tm-soc {
    list-style: none;
    display: flex;
    gap: 0.5rem;
    margin: auto 0 0;
    padding: 0.9rem 0 0;
    border-top: 1px solid var(--line);
  }
  .tm-soc a,
  .tm-soc .off {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    color: var(--gold-bright);
    border: 1px solid var(--line-strong);
    transition:
      transform 0.35s var(--ease),
      background 0.35s var(--ease),
      color 0.35s var(--ease),
      border-color 0.35s var(--ease);
  }
  .tm-soc a:hover,
  .tm-soc a:focus-visible {
    transform: translateY(-3px);
    background: var(--gold);
    border-color: var(--gold);
    color: #fff;
  }
  .tm-soc .off {
    opacity: 0.38;
    cursor: default;
  }
  .reveal .tm-soc li {
    opacity: 0;
    transform: translateY(8px) scale(0.85);
  }
  .reveal.is-visible .tm-soc li {
    animation: tm-pop 0.55s var(--ease) both;
    animation-delay: calc(var(--d) + 0.55s + var(--k) * 80ms);
  }
  .tip {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    translate: -50% 4px;
    padding: 0.25rem 0.55rem;
    border-radius: 0.4rem;
    font-size: 0.72rem;
    font-weight: 600;
    white-space: nowrap;
    color: #fff;
    background: #1a1813;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.25s,
      translate 0.25s;
  }
  .tm-soc a:hover .tip,
  .tm-soc a:focus-visible .tip,
  .tm-soc .off:hover .tip {
    opacity: 1;
    translate: -50% 0;
  }

  /* apparition : montée + netteté */
  .team .tm-card.reveal {
    transform: translateY(34px);
    filter: blur(6px);
    transition:
      opacity 1s var(--ease),
      transform 1s var(--ease),
      filter 1s var(--ease);
    transition-delay: var(--d);
  }
  .team .tm-card.reveal.is-visible {
    transform: none;
    filter: none;
  }
  .tm-more {
    margin-top: 2.5rem;
    text-align: center;
  }

  @keyframes tm-spin {
    to {
      --tm-a: 360deg;
    }
  }
  @keyframes tm-breathe {
    50% {
      opacity: 0.55;
      scale: 0.94;
    }
  }
  @keyframes tm-shine {
    from {
      transform: translateX(-130%);
    }
    to {
      transform: translateX(130%);
    }
  }
  @keyframes tm-pop {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 520px) {
    .tm-card {
      flex-basis: 100%;
      max-width: 22rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tm-aura,
    .tm-card::before,
    .reveal.is-visible .tm-media::after {
      animation: none;
    }
    .team .tm-card.reveal {
      filter: none;
    }
    .reveal .tm-soc li,
    .reveal.is-visible .tm-soc li {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>
