---
/**
 * Section « L'équipe » — contenu géré dans l'espace d'administration (bloc « team »).
 * Accueil : toute l'équipe, la personne « mise en avant » en grand.
 * Page À propos (`mode="about"`) : seulement les autres membres (le fondateur y est déjà présenté) ;
 * la section disparaît tant qu'il n'y en a pas.
 */
import page from '../data/pages/team.ts';
import { block } from '../data/site.ts';
import SectionHead from './SectionHead.astro';
import Arrow from './Arrow.astro';
import { path, type Lang } from '../i18n.ts';

interface Props { lang: Lang; mode?: 'home' | 'about'; }
const { lang, mode = 'home' } = Astro.props;
const T = block(Astro.locals, 'team', lang, page);

type Member = (typeof page)['fr']['members'][number];
const all = ((T.members ?? []) as Member[]).filter((m) => m && m.name?.trim());
const featured = mode === 'home' ? all.find((m) => m.featured) : undefined;
const others = all.filter((m) => m !== featured && !(mode === 'about' && m.featured));

const clean = (v?: string) => (v ?? '').trim();
const url = (base: string, v: string) => (/^https?:\/\//i.test(v) ? v : base + v.replace(/^@/, ''));
function links(m: Member) {
  const out: { key: string; label: string; href: string }[] = [];
  const gh = clean(m.github), li = clean(m.linkedin), ig = clean(m.instagram), wa = clean(m.whatsapp), em = clean(m.email);
  // LinkedIn reste visible même vide (grisé, « bientôt ») : le lien s'ajoute plus tard dans l'administration
  out.push({ key: 'linkedin', label: 'LinkedIn', href: li ? url('https://www.linkedin.com/in/', li) : '' });
  if (gh) out.push({ key: 'github', label: 'GitHub', href: url('https://github.com/', gh) });
  if (ig) out.push({ key: 'instagram', label: 'Instagram', href: url('https://www.instagram.com/', ig) });
  if (wa) out.push({ key: 'whatsapp', label: 'WhatsApp', href: /^https?:/i.test(wa) ? wa : `https://wa.me/${wa.replace(/\D/g, '')}` });
  if (em) out.push({ key: 'email', label: 'E-mail', href: `mailto:${em}` });
  return out;
}
const ICONS: Record<string, string> = {
  github: '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>',
  linkedin: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>',
  instagram: '<rect width="20" height="20" x="2" y="2" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><path d="M17.5 6.5h.01"/>',
  whatsapp: '<path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"/><path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1"/>',
  email: '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
};
const show = !!featured || others.length > 0;
---
{show && (
  <section class="section team" id={mode === 'home' ? 'equipe' : 'equipe-about'}>
    <div class="wrap">
      <SectionHead eyebrow={T.eyebrow} title={T.title} lead={T.lead} center />

      {featured && (
        <article class="tm-feature reveal">
          <div class="tm-frame">
            <span class="tm-ring" aria-hidden="true"></span>
            <div class="tm-photo">
              <img src={featured.photo} alt={featured.name} width="640" height="800" loading="lazy" decoding="async" />
            </div>
            <span class="tm-seal" aria-hidden="true">
              <img class="theme-dark-only" src="/images/aulia-mark.png" alt="" />
              <img class="theme-light-only" src="/images/aulia-mark-light.png" alt="" />
            </span>
          </div>
          <div class="tm-body">
            <p class="tm-role">{featured.role}</p>
            <h3 class="tm-name">{featured.name}</h3>
            {clean(featured.expertise) && <p class="tm-exp">{featured.expertise}</p>}
            {clean(featured.quote) && <blockquote class="tm-quote">« {featured.quote} »</blockquote>}
            {clean(featured.bio) && <p class="tm-bio">{featured.bio}</p>}
            <ul class="tm-soc" aria-label={`${T.contactLabel} ${featured.name}`}>
              {links(featured).map((l, i) => (
                <li style={`--i:${i}`}>
                  {l.href ? (
                    <a href={l.href} target={l.key === 'email' ? undefined : '_blank'} rel="noopener me" aria-label={`${l.label} — ${featured.name}`} data-track={`Équipe : ${l.label}`}>
                      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[l.key]} />
                      <span class="tip">{l.label}</span>
                    </a>
                  ) : (
                    <span class="off" role="img" aria-label={`${l.label} — ${T.soonLabel}`}>
                      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[l.key]} />
                      <span class="tip">{l.label} · {T.soonLabel}</span>
                    </span>
                  )}
                </li>
              ))}
            </ul>
            {mode === 'home' && <a class="link-arrow tm-more" href={path(lang, 'about')}>{T.aboutLink}<Arrow /></a>}
          </div>
        </article>
      )}

      {others.length > 0 && (
        <ul class="tm-grid">
          {others.map((m, n) => (
            <li class="tm-card reveal" style={`transition-delay:${n * 90}ms`}>
              <div class="tm-card-photo">
                {clean(m.photo) ? <img src={m.photo} alt={m.name} width="480" height="600" loading="lazy" decoding="async" /> : <span class="tm-initials" aria-hidden="true">{m.name.split(/\s+/).slice(0, 2).map((w) => w[0]).join('')}</span>}
                <ul class="tm-soc small" aria-label={`${T.contactLabel} ${m.name}`}>
                  {links(m).map((l, i) => (
                    <li style={`--i:${i}`}>
                      {l.href ? (
                        <a href={l.href} target={l.key === 'email' ? undefined : '_blank'} rel="noopener" aria-label={`${l.label} — ${m.name}`} title={l.label}>
                          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[l.key]} />
                        </a>
                      ) : (
                        <span class="off" role="img" aria-label={`${l.label} — ${T.soonLabel}`} title={`${l.label} · ${T.soonLabel}`}>
                          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[l.key]} />
                        </span>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
              <div class="tm-card-body">
                <b>{m.name}</b>
                <span class="tm-role">{m.role}</span>
                {clean(m.expertise) && <span class="tm-exp">{m.expertise}</span>}
                {clean(m.bio) && <p>{m.bio}</p>}
              </div>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
)}

<style>
  @property --tm-a {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }
  .team {
    position: relative;
    overflow: hidden;
  }
  .team::before {
    content: '';
    position: absolute;
    inset: auto -20% -40% -20%;
    height: 70%;
    background: radial-gradient(ellipse at 50% 100%, rgba(150, 114, 29, 0.16), transparent 65%);
    pointer-events: none;
  }

  /* ── personne mise en avant ── */
  .tm-feature {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    max-width: 68rem;
    margin: clamp(2.5rem, 5vw, 3.5rem) auto 0;
  }
  .tm-frame {
    position: relative;
    padding: 6px;
    border-radius: 1.75rem;
    isolation: isolate;
  }
  .tm-ring {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: conic-gradient(from var(--tm-a), rgba(150, 114, 29, 0.15), #ffd230, rgba(150, 114, 29, 0.15) 30%, rgba(150, 114, 29, 0.15) 60%, #c99a2e, rgba(150, 114, 29, 0.15));
    animation: tm-spin 9s linear infinite;
    z-index: -1;
  }
  .tm-frame::after {
    content: '';
    position: absolute;
    inset: -18px;
    border-radius: 2.4rem;
    background: radial-gradient(closest-side, rgba(255, 210, 48, 0.18), transparent);
    filter: blur(18px);
    z-index: -2;
    animation: tm-breathe 6s ease-in-out infinite;
  }
  .tm-photo {
    position: relative;
    overflow: hidden;
    border-radius: 1.4rem;
    aspect-ratio: 4 / 5;
    background: var(--card);
  }
  .tm-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1.06);
    transition: transform 1.4s var(--ease), filter 1.4s var(--ease);
    filter: saturate(0.92);
  }
  .reveal.is-visible .tm-photo img {
    transform: scale(1);
  }
  .tm-feature:hover .tm-photo img {
    transform: scale(1.035);
    filter: saturate(1.05);
  }
  .tm-photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, transparent 35%, rgba(255, 236, 170, 0.35) 50%, transparent 65%);
    transform: translateX(-120%);
    pointer-events: none;
  }
  .reveal.is-visible .tm-photo::after {
    animation: tm-shine 2.2s 0.6s var(--ease) both;
  }
  .tm-feature:hover .tm-photo::after {
    animation: tm-shine 1.4s var(--ease) both;
  }
  .tm-seal {
    position: absolute;
    right: -14px;
    bottom: 28px;
    width: 58px;
    height: 58px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--bg, #11100d);
    border: 1px solid var(--gold);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
  }
  .tm-seal img {
    width: 62%;
    height: auto;
  }

  .tm-role {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-bright);
  }
  .tm-name {
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3.6vw, 2.9rem);
    font-weight: 700;
    line-height: 1.08;
    color: var(--text);
  }
  .tm-exp {
    display: block;
    margin-top: 0.5rem;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .tm-quote {
    position: relative;
    margin: 1.6rem 0 0;
    padding-left: 1.2rem;
    border-left: 2px solid var(--gold);
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1.9vw, 1.4rem);
    font-weight: 600;
    line-height: 1.4;
    color: var(--text);
  }
  .tm-bio {
    margin-top: 1.1rem;
    color: var(--text-soft);
    line-height: 1.7;
  }
  .tm-more {
    display: inline-flex;
    margin-top: 1.6rem;
  }

  /* ── réseaux ── */
  .tm-soc {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.6rem 0 0;
    padding: 0;
  }
  .tm-soc a,
  .tm-soc .off {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    color: var(--gold-bright);
    border: 1px solid var(--line-strong);
    background: var(--card);
    transition:
      transform 0.35s var(--ease),
      background 0.35s var(--ease),
      color 0.35s var(--ease),
      border-color 0.35s var(--ease);
  }
  .tm-soc a:hover,
  .tm-soc a:focus-visible {
    transform: translateY(-3px);
    background: var(--gold);
    border-color: var(--gold);
    color: #fff;
  }
  .reveal .tm-soc li {
    opacity: 0;
    transform: translateY(10px) scale(0.85);
  }
  .reveal.is-visible .tm-soc li {
    animation: tm-pop 0.6s var(--ease) both;
    animation-delay: calc(var(--i) * 90ms + 0.5s);
  }
  .tip {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    translate: -50% 4px;
    padding: 0.25rem 0.55rem;
    border-radius: 0.4rem;
    font-size: 0.72rem;
    font-weight: 600;
    white-space: nowrap;
    color: #fff;
    background: #1a1813;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.25s,
      translate 0.25s;
  }
  .tm-soc .off {
    opacity: 0.4;
    cursor: default;
  }
  .tm-soc .off:hover .tip,
  .tm-soc a:hover .tip,
  .tm-soc a:focus-visible .tip {
    opacity: 1;
    translate: -50% 0;
  }

  /* ── autres membres ── */
  .tm-grid {
    list-style: none;
    margin: clamp(3rem, 6vw, 4.5rem) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
  }
  .tm-card {
    flex: 0 1 17rem;
    border-radius: 1.25rem;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    background: var(--card);
    transition:
      transform 0.45s var(--ease),
      border-color 0.45s var(--ease),
      opacity 0.9s var(--ease);
  }
  .tm-card:hover {
    transform: translateY(-5px);
    border-color: var(--gold);
  }
  .tm-card-photo {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: linear-gradient(160deg, rgba(150, 114, 29, 0.25), rgba(17, 16, 13, 0.6));
  }
  .tm-card-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 1s var(--ease);
  }
  .tm-card:hover .tm-card-photo img {
    transform: scale(1.05);
  }
  .tm-initials {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 700;
    color: #ffd230;
  }
  .tm-soc.small {
    position: absolute;
    left: 0.9rem;
    right: 0.9rem;
    bottom: 0.9rem;
    margin: 0;
    justify-content: center;
  }
  .tm-soc.small a,
  .tm-soc.small .off {
    width: 2.3rem;
    height: 2.3rem;
    background: rgba(17, 16, 13, 0.72);
    border-color: rgba(255, 255, 255, 0.18);
    color: #ffd230;
    backdrop-filter: blur(6px);
  }
  @media (hover: hover) {
    .tm-card .tm-soc.small {
      opacity: 0;
      transform: translateY(12px);
      transition:
        opacity 0.4s var(--ease),
        transform 0.4s var(--ease);
    }
    .tm-card:hover .tm-soc.small,
    .tm-card:focus-within .tm-soc.small {
      opacity: 1;
      transform: none;
    }
  }
  .tm-card-body {
    display: grid;
    gap: 0.3rem;
    padding: 1.1rem 1.25rem 1.35rem;
  }
  .tm-card-body b {
    font-size: 1.1rem;
    color: var(--text);
  }
  .tm-card-body .tm-role {
    font-size: 0.68rem;
  }
  .tm-card-body .tm-exp {
    margin: 0;
    font-size: 0.85rem;
  }
  .tm-card-body p {
    margin-top: 0.4rem;
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.6;
  }

  @keyframes tm-spin {
    to {
      --tm-a: 360deg;
    }
  }
  @keyframes tm-breathe {
    50% {
      opacity: 0.55;
      transform: scale(0.97);
    }
  }
  @keyframes tm-shine {
    from {
      transform: translateX(-120%);
    }
    to {
      transform: translateX(120%);
    }
  }
  @keyframes tm-pop {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 860px) {
    .tm-feature {
      grid-template-columns: 1fr;
      max-width: 30rem;
      text-align: center;
    }
    .tm-quote {
      border-left: 0;
      padding-left: 0;
    }
    .tm-soc {
      justify-content: center;
    }
    .tm-seal {
      right: 12px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tm-ring,
    .tm-frame::after,
    .reveal.is-visible .tm-photo::after {
      animation: none;
    }
    .reveal .tm-soc li,
    .reveal.is-visible .tm-soc li {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>
