---
interface Props { eyebrow: string; title: string; lead?: string; }
const { eyebrow, title, lead } = Astro.props;
---
<section class="page-hero">
  <div class="blobs" aria-hidden="true"></div>
  <div class="wrap">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="display display-l" set:html={title} />
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    padding-top: clamp(9rem, 18vw, 13rem);
    padding-bottom: clamp(4rem, 8vw, 6.5rem);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .grid-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 70% at 85% 0%, rgba(198, 164, 92, 0.1), transparent 70%),
      linear-gradient(var(--line) 1px, transparent 1px) 0 0 / 100% 120px;
    mask-image: linear-gradient(180deg, #000 0%, transparent 85%);
    -webkit-mask-image: linear-gradient(180deg, #000 0%, transparent 85%);
    opacity: 0.7;
  }
  .wrap { position: relative; }
  h1 { margin-top: 1.25rem; max-width: 18em; }
  .lead { margin-top: 1.75rem; }
</style>
