---
import { uiText } from '../data/site.ts';
/**
 * Emblème animé du hero.
 * Séquence : un point apparaît → d'autres points → connexions → géométrie
 * circulaire → le cercle se dessine → la lettre A émerge → le point d'or →
 * la courbe traverse l'ouverture du cercle → le logotype apparaît.
 *
 * Le tracé de l'emblème est une reconstruction vectorielle du logo existant ;
 * à remplacer par le fichier vectoriel officiel lorsqu'il sera disponible.
 */
import { ui, type Lang } from '../i18n.ts';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = uiText(lang, Astro.locals);
const C = 300;
const outer = [-96, -58, -18, 22, 58, 96, 134, 172, 212, 248].map((deg, i) => {
  const r = i % 2 ? 236 : 252;
  const a = (deg * Math.PI) / 180;
  return { x: C + r * Math.cos(a), y: C + r * Math.sin(a) };
});
const inner = [-130, -70, -10, 50, 110, 170, 230].map((deg) => {
  const a = (deg * Math.PI) / 180;
  return { x: C + 168 * Math.cos(a), y: C + 168 * Math.sin(a) };
});
const lines: { x1: number; y1: number; x2: number; y2: number }[] = [];
outer.forEach((p, i) => {
  const n = outer[(i + 1) % outer.length];
  lines.push({ x1: p.x, y1: p.y, x2: n.x, y2: n.y });
});
inner.forEach((p, i) => {
  lines.push({ x1: C, y1: C, x2: p.x, y2: p.y });
  const o = outer[Math.round((i / inner.length) * outer.length) % outer.length];
  lines.push({ x1: p.x, y1: p.y, x2: o.x, y2: o.y });
});
const f = (n: number) => n.toFixed(1);
---

<div class="emblem" data-emblem>
  <svg viewBox="0 0 600 680" role="img" aria-labelledby="emblem-title">
    <title id="emblem-title">{t.emblem}</title>
    <defs>
      <linearGradient id="ring" x1="0" y1="1" x2="1" y2="0">
        <stop offset="0" stop-color="#1d1e22" />
        <stop offset="0.32" stop-color="#7c7d82" />
        <stop offset="0.58" stop-color="#b8954f" />
        <stop offset="1" stop-color="#e4c77d" />
      </linearGradient>
      <linearGradient id="goldfill" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#e9cf86" />
        <stop offset="0.55" stop-color="#c6a45c" />
        <stop offset="1" stop-color="#8f6c27" />
      </linearGradient>
      <radialGradient id="dotfill" cx="0.38" cy="0.35" r="0.7">
        <stop offset="0" stop-color="#f6e2a6" />
        <stop offset="0.6" stop-color="#c6a45c" />
        <stop offset="1" stop-color="#7e5d1e" />
      </radialGradient>
      <radialGradient id="halo" cx="0.5" cy="0.5" r="0.5">
        <stop offset="0" stop-color="#c6a45c" stop-opacity="0.16" />
        <stop offset="1" stop-color="#c6a45c" stop-opacity="0" />
      </radialGradient>
    </defs>

    <circle class="halo" cx={C} cy={C} r="290" fill="url(#halo)" />

    <g class="network">
      {lines.map((l, i) => (
        <line class="ln" x1={f(l.x1)} y1={f(l.y1)} x2={f(l.x2)} y2={f(l.y2)} pathLength="1" style={`--i:${i}`} />
      ))}
      {outer.map((p, i) => <circle class="sat" cx={f(p.x)} cy={f(p.y)} r="2.6" style={`--i:${i}`} />)}
      {inner.map((p, i) => <circle class="sat inner" cx={f(p.x)} cy={f(p.y)} r="2" style={`--i:${i + 4}`} />)}
    </g>

    <circle class="origin" cx={C} cy={C} r="5" />

    <!-- Emblème : coordonnées d'origine 186 × 185, mises à l'échelle -->
    <g class="mark" transform="translate(151 151) scale(1.6)">
      <path class="ring" d="M110.9 176.1 A86 86 0 1 1 165.1 138.8" fill="none" stroke="url(#ring)" stroke-width="2.6" stroke-linecap="round" pathLength="1" />
      <path class="letter" d="M88 57 L101 57 L146 139 L135 137 L96 76 L61 141 L44 141 Z" fill="#f3f1eb" />
      <circle class="dot" cx="98" cy="40" r="9.5" fill="url(#dotfill)" />
      <path class="wave" d="M76 130 C88 120 103 119 117 131 C131 144 146 158 167 165 C148 168 131 162 119 151 C106 139 93 131 76 130 Z" fill="url(#goldfill)" />
      <circle class="spark" r="2.2" cx="0" cy="0" />
    </g>

    <image class="wordmark" href="/images/aulia-wordmark.png" x="210" y="616" width="180" height="42" preserveAspectRatio="xMidYMid meet" />
  </svg>

  <button type="button" class="skip" data-skip>{t.skipAnimation}</button>
</div>

<style>
  .emblem {
    position: relative;
    width: 100%;
    max-width: 560px;
    margin-inline: auto;
  }
  svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .ln {
    stroke: var(--gold);
    stroke-width: 0.6;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0.55;
    animation:
      draw 0.9s var(--ease) forwards,
      settle 1.2s var(--ease) forwards;
    animation-delay: calc(1s + var(--i) * 0.035s), 2.6s;
  }
  .sat {
    fill: var(--ivory);
    opacity: 0;
    animation: pop 0.6s var(--ease) forwards;
    animation-delay: calc(0.55s + var(--i) * 0.07s);
  }
  .sat.inner {
    fill: var(--gold-bright);
  }
  .origin {
    fill: var(--gold-bright);
    opacity: 0;
    transform-origin: 300px 300px;
    animation:
      pop 0.5s var(--ease) 0.15s forwards,
      fadeout 0.6s var(--ease) 2.9s forwards;
  }
  .halo {
    opacity: 0;
    animation: fade 2s var(--ease) 2.2s forwards;
  }
  .ring {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 1.1s var(--ease) 2s forwards;
  }
  .letter {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: rise 0.8s var(--ease) 2.8s forwards;
  }
  .dot {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: pop 0.6s var(--ease) 3.25s forwards;
  }
  .wave {
    clip-path: inset(0 100% 0 0);
    animation: sweep 0.9s var(--ease) 3.5s forwards;
  }
  .wordmark {
    opacity: 0;
    animation: fade 0.9s var(--ease) 4.1s forwards;
  }
  .spark {
    fill: var(--gold-bright);
    opacity: 0;
    offset-path: path('M110.9 176.1 A86 86 0 1 1 165.1 138.8');
    animation:
      fade 0.6s var(--ease) 4.6s forwards,
      orbit 9s linear 4.6s infinite;
  }

  .skip {
    position: absolute;
    right: 0;
    bottom: -0.5rem;
    background: none;
    border: 0;
    padding: 0.4rem 0;
    font: inherit;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--faint);
    cursor: pointer;
    animation: fadeout 0.4s var(--ease) 4.4s forwards;
  }
  .skip:hover {
    color: var(--gold);
  }

  /* État final immédiat (animation passée, déjà vue ou mouvement réduit) */
  .emblem.done * {
    animation: none !important;
  }
  .emblem.done .ln {
    stroke-dashoffset: 0;
    opacity: 0.16;
  }
  .emblem.done .sat {
    opacity: 0.5;
  }
  .emblem.done .origin {
    opacity: 0;
  }
  .emblem.done .halo,
  .emblem.done .letter,
  .emblem.done .dot,
  .emblem.done .wordmark {
    opacity: 1;
    transform: none;
  }
  .emblem.done .ring {
    stroke-dashoffset: 0;
  }
  .emblem.done .wave {
    clip-path: none;
  }
  .emblem.done .skip {
    display: none;
  }
  .emblem.done .spark {
    opacity: 1;
    animation: orbit 9s linear infinite !important;
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes settle {
    to {
      opacity: 0.16;
    }
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: scale(0.2);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
  @keyframes fade {
    to {
      opacity: 1;
    }
  }
  @keyframes fadeout {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(8px) scaleY(0.92);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes sweep {
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes orbit {
    from {
      offset-distance: 0%;
    }
    to {
      offset-distance: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .spark {
      display: none;
    }
  }
</style>

<script>
  const el = document.querySelector('[data-emblem]');
  const KEY = 'aulia-intro-vue';
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let seen = false;
  try {
    seen = sessionStorage.getItem(KEY) === '1';
    sessionStorage.setItem(KEY, '1');
  } catch (_) {
    /* stockage indisponible : l'animation joue normalement */
  }
  // L'écran de chargement joue déjà la construction de l'emblème : on affiche l'état final.
  const preloading = document.documentElement.classList.contains('preloading');
  if (el && (seen || reduced || preloading)) el.classList.add('done');
  el?.querySelector('[data-skip]')?.addEventListener('click', () => el.classList.add('done'));
</script>
