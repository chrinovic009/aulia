---
import AdminAuth from '../../layouts/AdminAuth.astro';
import { env } from '../../lib/server/env.ts';
const errors: Record<string, string> = {
  'github-non-configure': 'La connexion avec GitHub n’est pas encore configurée.',
  'github-non-relie': 'Ce compte GitHub n’est relié à aucun accès. Connectez-vous avec votre e-mail, puis reliez GitHub dans « Sécurité du compte ».',
  'github-etat': 'La connexion GitHub a expiré. Réessayez.',
  'github-refus': 'GitHub a refusé la connexion.',
  'github-profil': 'Impossible de lire le profil GitHub.',
  'github-session': 'Connectez-vous d’abord pour relier GitHub.',
  'github-mot-de-passe': 'GitHub est votre deuxième étape : connectez-vous d’abord avec votre adresse et votre mot de passe, puis confirmez avec GitHub.',
};
const err = errors[Astro.url.searchParams.get('erreur') ?? ''];
const github = !!env('GITHUB_CLIENT_ID');
if (Astro.locals.user && Astro.locals.user.aal >= 2) return Astro.redirect('/admin');
---
<AdminAuth title="Espace AULIA" lead="Accès réservé au fondateur, aux directions et aux équipes du groupe.">
  {err && <p class="a-note err">{err}</p>}
  <form class="a-form" data-auth="/api/auth/login">
    <label class="a-field"><span>Adresse e-mail</span><input name="email" type="email" autocomplete="username" required /></label>
    <label class="a-field"><span>Mot de passe</span><input name="password" type="password" autocomplete="current-password" required /></label>
    <button class="a-btn primary" type="submit">Se connecter</button>
  </form>
  {github && (
    <>
      <div class="a-or">ou</div>
      <a class="a-btn" href="/api/auth/github/start">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0C17.3 4.7 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.2c0 .3.2.7.8.6A11.5 11.5 0 0 0 12 .5z"/></svg>
        Se connecter avec GitHub
      </a>
    </>
  )}
  <div class="links">
    <a href="/admin/recuperation">Mot de passe oublié ?</a>
    <a href="/admin/rejoindre">J’ai reçu une invitation</a>
  </div>
</AdminAuth>
