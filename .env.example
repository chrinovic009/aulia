# ─── Base de données PostgreSQL (Neon via Vercel → Storage, ou tout PostgreSQL) ───
# URL « poolée » pour l'application, URL directe pour les migrations Prisma.
DATABASE_URL="postgresql://utilisateur:motdepasse@hote/aulia?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://utilisateur:motdepasse@hote/aulia?sslmode=require"

# ─── Sécurité ───
# Chaîne aléatoire d'au moins 32 caractères (ex. : openssl rand -base64 48). Ne jamais la partager.
APP_SECRET=""
# Nettoyage nocturne (Vercel Cron) : chaîne aléatoire, Vercel l'envoie automatiquement à /api/cron/cleanup
CRON_SECRET=""
# Adresse du fondateur : seule cette adresse peut créer le tout premier compte.
FOUNDER_EMAIL="fondateur@exemple.com"

# ─── E-mails (Resend : https://resend.com) ───
RESEND_API_KEY=""
MAIL_FROM="AULIA <no-reply@aulia-holding.com>"
# Boîte qui reçoit une copie des messages du formulaire de contact
CONTACT_INBOX="contact@aulia-holding.com"

# ─── Connexion avec GitHub (facultatif) : github.com/settings/developers → OAuth App ───
# URL de rappel : https://www.aulia-holding.com/api/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ─── ANIMA (agent Aulia : orbe du site) ───
# Moteur de langage au format « compatible OpenAI ». Par défaut : Google Gemini
# (clé gratuite sur https://aistudio.google.com/apikey). Sans clé, l'orbe reste en « veille ».
ANIMA_LLM_API_KEY=""
ANIMA_LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
ANIMA_LLM_MODEL="gemini-flash-latest"
# Facultatif : réduire le temps de réflexion du modèle (minimal, low, medium, high)
ANIMA_LLM_REASONING="low"
# Facultatif : moteur de secours (ex. Groq : https://api.groq.com/openai/v1)
ANIMA_LLM2_API_KEY=""
ANIMA_LLM2_BASE_URL=""
ANIMA_LLM2_MODEL=""
# Alertes « prospect prioritaire » et « demande de présentation » (par défaut : FOUNDER_EMAIL)
ANIMA_ALERT_EMAIL=""
ANIMA_LEAD_ALERT_THRESHOLD="60"
