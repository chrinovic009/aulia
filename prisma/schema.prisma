// AULIA — base de données du portail et de l'espace interne.
//
// Règles d'accès principales (appliquées dans src/lib/server/authz.ts ET, pour les verrous
// critiques, directement dans la base par des déclencheurs : voir prisma/migrations/0001_init).
//  1. Seul le fondateur nomme les DG et les rôles du groupe.
//  2. Une personne déjà présente dans une filiale ne peut être ajoutée à une autre que par le fondateur.
//  3. Rien n'apparaît sur le site public sans validation du fondateur (ou d'un validateur délégué).

generator client {
  provider      = "prisma-client-js"
  // « native » pour votre ordinateur, « rhel-openssl-3.0.x » pour les serveurs Vercel
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum OrgKind {
  HOLDING
  SUBSIDIARY
}

enum OrgStatus {
  ACTIVE
  PREPARING
  ARCHIVED
}

enum RoleScope {
  GROUP
  SUBSIDIARY
}

enum MemberStatus {
  ACTIVE
  SUSPENDED
  ENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum VersionStatus {
  DRAFT
  SUBMITTED
  REJECTED
  PUBLISHED
  ARCHIVED
}

enum Locale {
  en
  fr
}

enum OtpPurpose {
  BOOTSTRAP
  JOIN
  RECOVERY
}

enum MessageStatus {
  NEW
  READ
  HANDLED
  ARCHIVED
}

enum SiteEventKind {
  VIEW
  CLICK
}

// ───────────────────────────── Personnes et sécurité ─────────────────────────────

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  passwordHash    String?   @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at")
  /// secret TOTP chiffré (AES-256-GCM avec APP_SECRET)
  totpSecret      String?   @map("totp_secret")
  totpPending     String?   @map("totp_pending")
  totpEnabledAt   DateTime? @map("totp_enabled_at")
  githubId        String?   @unique @map("github_id")
  githubLogin     String?   @map("github_login")
  recoveryEmail   String?   @map("recovery_email")
  disabledAt      DateTime? @map("disabled_at")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  memberships   Membership[]
  sessions      Session[]
  recoveryCodes RecoveryCode[]
  authored      ContentVersion[] @relation("authored")
  reviewed      ContentVersion[] @relation("reviewed")
  audit         AuditLog[]

  @@map("users")
}

model Session {
  /// empreinte SHA-256 du jeton (le jeton lui-même n'est jamais stocké)
  id         String   @id
  userId     String   @map("user_id")
  /// 1 = mot de passe ou GitHub ; 2 = deuxième étape validée
  aal        Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  expiresAt  DateTime @map("expires_at")
  ip         String?
  userAgent  String?  @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model RecoveryCode {
  id       String    @id @default(cuid())
  userId   String    @map("user_id")
  codeHash String    @map("code_hash")
  usedAt   DateTime? @map("used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

model OtpCode {
  id         String     @id @default(cuid())
  email      String
  purpose    OtpPurpose
  codeHash   String     @map("code_hash")
  attempts   Int        @default(0)
  expiresAt  DateTime   @map("expires_at")
  consumedAt DateTime?  @map("consumed_at")
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([email, purpose])
  @@map("otp_codes")
}

model LoginAttempt {
  id    BigInt   @id @default(autoincrement())
  email String
  ok    Boolean
  at    DateTime @default(now())

  @@index([email, at])
  @@map("login_attempts")
}

// ───────────────────────────── Groupe ─────────────────────────────

model Organization {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  kind        OrgKind
  status      OrgStatus @default(PREPARING)
  sector      String?
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  memberships Membership[]
  invitations Invitation[]
  blocks      ContentBlock[]
  messages    ContactMessage[]

  @@map("organizations")
}

model Role {
  code        String    @id
  scope       RoleScope
  labelFr     String    @map("label_fr")
  labelEn     String    @map("label_en")
  description String
  /// plus petit = plus d'autorité (fondateur 0, DG 10…)
  rank        Int
  permissions String[]

  memberships Membership[]
  invitations Invitation[]

  @@map("roles")
}

model Membership {
  id          String       @id @default(cuid())
  userId      String       @map("user_id")
  orgId       String       @map("org_id")
  roleCode    String       @map("role_code")
  title       String?
  status      MemberStatus @default(ACTIVE)
  createdById String?      @map("created_by_id")
  updatedById String?      @map("updated_by_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  endedAt     DateTime?    @map("ended_at")

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role Role         @relation(fields: [roleCode], references: [code])

  @@unique([userId, orgId])
  @@index([orgId])
  @@map("memberships")
}

model Invitation {
  id          String           @id @default(cuid())
  email       String
  orgId       String           @map("org_id")
  roleCode    String           @map("role_code")
  title       String?
  invitedById String           @map("invited_by_id")
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime         @map("expires_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  acceptedAt  DateTime?        @map("accepted_at")

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role Role         @relation(fields: [roleCode], references: [code])

  @@index([email, status])
  @@index([orgId])
  @@map("invitations")
}

// ───────────────────────────── Contenu du site public ─────────────────────────────

model ContentBlock {
  id        String   @id @default(cuid())
  /// ex. « site », « page:home », « entity:care »
  key       String   @unique
  orgId     String   @map("org_id")
  label     String
  /// pages publiques où le bloc apparaît (« * » = toutes)
  pages     String[]
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  org      Organization     @relation(fields: [orgId], references: [id])
  versions ContentVersion[]
  live     ContentLive[]

  @@map("content_blocks")
}

model ContentVersion {
  id            String        @id @default(cuid())
  blockId       String        @map("block_id")
  orgId         String        @map("org_id")
  locale        Locale
  data          Json
  status        VersionStatus @default(DRAFT)
  note          String?
  authorId      String?       @map("author_id")
  reviewerId    String?       @map("reviewer_id")
  reviewComment String?       @map("review_comment")
  baseVersionId String?       @map("base_version_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  submittedAt   DateTime?     @map("submitted_at")
  reviewedAt    DateTime?     @map("reviewed_at")
  publishedAt   DateTime?     @map("published_at")

  block    ContentBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  author   User?        @relation("authored", fields: [authorId], references: [id])
  reviewer User?        @relation("reviewed", fields: [reviewerId], references: [id])

  @@index([blockId, locale, status])
  @@index([orgId, status])
  @@map("content_versions")
}

model ContentLive {
  blockId       String   @map("block_id")
  locale        Locale
  orgId         String   @map("org_id")
  versionId     String   @map("version_id")
  data          Json
  publishedAt   DateTime @default(now()) @map("published_at")
  publishedById String?  @map("published_by_id")

  block ContentBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@id([blockId, locale])
  @@map("content_live")
}

// ───────────────────────────── Relation avec les internautes ─────────────────────────────

model ContactMessage {
  id           String        @id @default(cuid())
  orgId        String        @map("org_id")
  topic        String
  name         String
  email        String
  organization String?
  phone        String?
  message      String
  lang         Locale
  status       MessageStatus @default(NEW)
  note         String?
  handledById  String?       @map("handled_by_id")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id])

  @@index([orgId, status])
  @@map("contact_messages")
}

model SiteEvent {
  id           BigInt        @id @default(autoincrement())
  at           DateTime      @default(now())
  kind         SiteEventKind
  path         String
  orgId        String?       @map("org_id")
  lang         String?
  country      String?
  referrerHost String?       @map("referrer_host")
  device       String?
  label        String?
  /// empreinte quotidienne anonyme (aucune adresse IP ni cookie conservé)
  visitorHash  String        @map("visitor_hash")

  @@index([orgId, at])
  @@index([at])
  @@map("site_events")
}

// ───────────────────────────── Traçabilité et temps réel ─────────────────────────────

model AuditLog {
  id       BigInt   @id @default(autoincrement())
  at       DateTime @default(now())
  actorId  String?  @map("actor_id")
  orgId    String?  @map("org_id")
  action   String
  entity   String
  entityId String?  @map("entity_id")
  summary  String?
  before   Json?
  after    Json?

  actor User? @relation(fields: [actorId], references: [id])

  @@index([orgId, at])
  @@map("audit_log")
}

/// Alimentée uniquement par des déclencheurs de la base : chaque ajout, modification ou
/// suppression produit un événement que les écrans ouverts reçoivent en direct.
model ChangeEvent {
  id     BigInt   @id @default(autoincrement())
  at     DateTime @default(now())
  scope  String
  topic  String
  action String
  orgId  String?  @map("org_id")
  ref    String?

  @@index([scope, id])
  @@map("change_events")
}

// ───────────────────────────── ANIMA — Mémoire du Royaume ─────────────────────────────
// Conversations de l'agent Aulia (orbe du site), prospects, pages personnalisées, journal.

model AnimaConversation {
  id        String   @id @default(cuid())
  agent     String
  visitorId String   @map("visitor_id")
  lang      String
  channel   String   @default("web")
  /// emails et téléphones laissés par le visiteur (jamais transmis au moteur de langage)
  contact   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  contactId String?  @map("contact_id")

  messages AnimaMessage[]
  lead     AnimaLead?
  pages    AnimaPage[]
  fiche    AnimaContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([visitorId])
  @@index([contactId])
  @@map("anima_conversations")
}

model AnimaMessage {
  id             BigInt   @id @default(autoincrement())
  conversationId String   @map("conversation_id")
  role           String
  content        String
  createdAt      DateTime @default(now()) @map("created_at")

  conversation AnimaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, id])
  @@map("anima_messages")
}

model AnimaLead {
  id             String   @id @default(cuid())
  conversationId String   @unique @map("conversation_id")
  agent          String
  nom            String   @default("")
  organisation   String   @default("")
  fonction       String   @default("")
  secteur        String   @default("")
  besoin         String   @default("")
  taille         String   @default("")
  interets       String   @default("")
  contact        String   @default("")
  score          Int      @default(0)
  priorite       String   @default("basse")
  raisons        String[] @default([])
  alerted        Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  conversation AnimaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([score])
  @@map("anima_leads")
}

model AnimaPage {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  lang           String
  data           Json
  createdAt      DateTime @default(now()) @map("created_at")

  conversation AnimaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("anima_pages")
}

model AnimaEvent {
  id             BigInt   @id @default(autoincrement())
  at             DateTime @default(now())
  agent          String
  kind           String
  conversationId String?  @map("conversation_id")
  detail         Json     @default("{}")

  @@index([kind, at])
  @@map("anima_events")
}

/// Personne mémorisée par ANIMA (reconnue d'une visite à l'autre).
model AnimaContact {
  id           String   @id @default(cuid())
  visitorIds   String[] @default([]) @map("visitor_ids")
  emails       String[] @default([])
  phones       String[] @default([])
  nom          String   @default("")
  organisation String   @default("")
  fonction     String   @default("")
  secteur      String   @default("")
  lang         String   @default("fr")
  /// faits utiles retenus par ANIMA (visible par l'agent)
  memo         String   @default("")
  /// notes internes du fondateur (jamais montrées au visiteur, mais connues d'ANIMA)
  notes        String   @default("")
  lastSeenAt   DateTime @default(now()) @map("last_seen_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  conversations AnimaConversation[]
  requests      AnimaRequest[]
  appointments  AnimaAppointment[]

  @@map("anima_contacts")
}

/// Demande transmise au fondateur par ANIMA, et suite donnée.
model AnimaRequest {
  id             String    @id @default(cuid())
  contactId      String    @map("contact_id")
  conversationId String?   @map("conversation_id")
  kind           String
  sujet          String
  details        String    @default("")
  /// nouvelle · en_cours · acceptee · refusee · traitee
  status         String    @default("nouvelle")
  /// réponse du fondateur, transmise par ANIMA au visiteur
  reply          String    @default("")
  replyDelivered Boolean   @default(false) @map("reply_delivered")
  handledAt      DateTime? @map("handled_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  contact      AnimaContact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  appointments AnimaAppointment[]

  @@index([status])
  @@index([contactId])
  @@map("anima_requests")
}

/// Rendez-vous de l'agenda (fixé par ANIMA dans les disponibilités, ou par le fondateur).
model AnimaAppointment {
  id            String   @id @default(cuid())
  contactId     String   @map("contact_id")
  requestId     String?  @map("request_id")
  startsAt      DateTime @map("starts_at")
  durationMin   Int      @default(45) @map("duration_min")
  mode          String   @default("visio")
  lieu          String   @default("")
  sujet         String   @default("")
  /// propose · confirme · annule · effectue
  status        String   @default("confirme")
  createdBy     String   @default("anima") @map("created_by")
  notes         String   @default("")
  /// le visiteur a-t-il été informé du dernier changement ?
  newsDelivered Boolean  @default(false) @map("news_delivered")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  contact AnimaContact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  request AnimaRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([startsAt])
  @@index([contactId])
  @@map("anima_appointments")
}

/// Réglages d'ANIMA (disponibilités, indisponibilités…).
model AnimaSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("anima_settings")
}
